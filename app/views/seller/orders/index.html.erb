<div class="w-full min-h-screen bg-white">
  <div class="w-full max-w-screen-xl mx-auto px-4 pb-10 space-y-6">
    <header class="flex items-center gap-3 pt-4">
      <%= link_to seller_root_path, class: "inline-flex size-10 items-center justify-center rounded-full border border-gray-200 text-gray-600 hover:bg-gray-50 transition", aria: { label: "กลับหน้าร้าน" } do %>
        <span class="iconify text-xl" data-icon="lucide:chevron-left"></span>
      <% end %>
      <div>
        <h1 class="text-lg font-semibold text-gray-900">คำสั่งซื้อจากลูกค้า</h1>
        <p class="text-sm text-gray-500">ออเดอร์ที่มีสินค้าของร้านคุณ</p>
      </div>
    </header>

    <div class="flex flex-wrap items-center gap-2">
      <% [
        [ "ทั้งหมด", nil ],
        [ "รอชำระเงิน", "pending" ],
        [ "ชำระแล้ว", "paid" ],
        [ "ยกเลิก", "cancelled" ],
        [ "ชำระไม่สำเร็จ", "failed" ]
      ].each do |label, status| %>
        <% active = (@status_filter.blank? && status.nil?) || @status_filter == status %>
        <%= link_to label,
            seller_orders_path(status: status),
            class: "rounded-full px-3 py-1.5 text-xs font-medium transition #{active ? "bg-pink-100 text-pink-800 ring-1 ring-pink-200" : "bg-gray-100 text-gray-600 hover:bg-gray-200"}" %>
      <% end %>
    </div>

    <% if @orders.any? %>
      <ul class="space-y-3">
        <% @orders.each do |order| %>
          <% payout = @payouts_by_order_id[order.id] %>
          <%= link_to seller_order_path(order), class: "block rounded-2xl border border-gray-100 bg-white p-4 shadow-sm ring-1 ring-gray-50 hover:border-pink-200 hover:shadow-md transition" do %>
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <p class="text-xs font-medium text-gray-400">คำสั่งซื้อ #<%= order.id %></p>
                <p class="mt-1 text-sm font-semibold text-gray-900">
                  รับเข้าร้าน
                  <span class="tabular-nums"><%= number_with_delimiter((payout&.amount_cents || 0) / 100.0) %> ฿</span>
                </p>
                <p class="mt-1 text-xs text-gray-500">
                  <% if order.paid? && order.paid_at.present? %>
                    ชำระเมื่อ <%= order.paid_at.strftime("%d/%m/%Y %H:%M") %>
                  <% else %>
                    สร้างเมื่อ <%= order.created_at.strftime("%d/%m/%Y %H:%M") %>
                  <% end %>
                </p>
              </div>
              <div class="text-right">
                <span class="inline-block rounded-full bg-gray-50 px-2.5 py-1 text-xs font-medium text-gray-700">
                  <%= seller_order_status_label(order) %>
                </span>
                <% if payout %>
                  <p class="mt-1 text-[11px] text-gray-400">โอน: <%= seller_payout_status_label(payout) %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </ul>
    <% else %>
      <div class="rounded-2xl border border-dashed border-gray-200 bg-gray-50/50 py-16 text-center text-sm text-gray-500">
        ไม่มีข้อมูล
      </div>
    <% end %>
  </div>
</div>
