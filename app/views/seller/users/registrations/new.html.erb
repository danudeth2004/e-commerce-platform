<div class="w-full max-w-md mx-auto">
    <div class="mb-6">
        <h2 class="text-2xl font-semibold text-gray-900 mb-1">
            สร้างบัญชีร้านค้าของคุณ
        </h2>
        <p class="text-sm text-gray-400 font-light">
            กรอกรายละเอียดเพื่อเริ่มการขายของคุณได้เลย
        </p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }) do |f| %>
    <%= render "seller/users/shared/error_messages", resource: resource %>

    <div class="grid grid-cols-2 gap-3 mb-4">
        <div>
            <%= f.label :first_name, "ชื่อ",
            class: "block text-base font-regular text-text-primary mb-2" %>

            <%= f.text_field :first_name,
            required: true,
            autofocus: true,
            placeholder: "กรอกชื่อ",
            class: "w-full px-3 py-2.5 text-sm text-text-primary
                    bg-white border border-border-neutral rounded-lg
                    placeholder:text-text-placeholder
                    focus:border-Primary-color focus:outline-none" %>
        </div>

        <div>
            <%= f.label :last_name,"นามสกุล",
            class: "block text-base font-regular text-text-primary mb-2" %>

            <%= f.text_field :last_name,
            required: true,
            placeholder: "กรอกนามสกุล",
            class: "w-full px-3 py-2.5 text-sm text-text-primary
                    bg-white border border-border-neutral rounded-lg
                    placeholder:text-text-placeholder
                    focus:border-Primary-color focus:outline-none" %>
        </div>
    </div>

    <div class="mb-4">
        <%= f.label :phone_number, "เบอร์โทรศัพท์",
        class: "block text-base font-regular text-text-primary mb-2" %>

        <%= f.text_field :phone_number,
        required: true,
        placeholder: "กรอกเบอร์โทรศัพท์",
        class: "w-full px-3 py-2.5 text-sm text-text-primary
                bg-white border border-border-neutral rounded-lg
                placeholder:text-text-placeholder
                focus:border-Primary-color focus:outline-none" %>
    </div>

    <div class="mb-4">
        <%= f.label :email, "ที่อยู่อีเมล",
        class: "block text-base font-regular text-text-primary mb-2" %>

        <%= f.email_field :email,
        required: true,
        autocomplete: "email",
        placeholder: "example@domain.com",
        class: "w-full px-3 py-2.5 text-sm text-text-primary
                bg-white border border-border-neutral rounded-lg
                placeholder:text-text-placeholder
                focus:border-Primary-color focus:outline-none" %>
    </div>


    <div class="mb-4">
      <%= f.label :password, "รหัสผ่าน",
        class: "block text-base font-regular text-text-primary mb-2" %>


      <% if @minimum_password_length %>
        <p class="text-xs text-gray-400 mb-2">
          อย่างน้อย <%= @minimum_password_length %> ตัวอักษร
        </p>
      <% end %>

      <%= f.password_field :password,
        required: true,
        autocomplete: "new-password",
        placeholder: "กรอกรหัสผ่าน",
        class: "w-full px-3 py-2.5 text-sm text-text-primary
                bg-white border border-border-neutral rounded-lg
                placeholder:text-text-placeholder
                focus:border-Primary-color focus:outline-none" %>
    </div>

    <div class="mb-6">
      <%= f.label :password_confirmation, "ยืนยันรหัสผ่าน",
    class: "block text-base font-regular text-text-primary mb-2" %>

    <%= f.password_field :password_confirmation,
    required: true,
    autocomplete: "new-password",
    placeholder: "ยืนยันรหัสผ่าน",
    class: "w-full px-3 py-2.5 text-sm text-text-primary
            bg-white border border-border-neutral rounded-lg
            placeholder:text-text-placeholder
            focus:border-Primary-color focus:outline-none" %>
    </div>

    <div class="mt-6">
      <%= f.submit "Sign up",
        class: "w-full py-3.5 text-white text-base font-medium
                rounded-full
                bg-gradient-to-r from-pink-500 to-pink-600
                shadow-lg shadow-pink-200
                hover:opacity-90 active:scale-95
                transition duration-200" %>
    </div>

  <% end %>

   <div class="flex flex-col gap-2 mt-6 text-center text-sm text-gray-400 font-light">
      <div class="mb-16">
        มีบัญชีอยู่แล้ว ?
        <%= link_to "เข้าสู่ระบบ", new_session_path(resource_name),
          class: "text-pink-500 font-medium hover:underline" %>
      </div>

      <p>
        ต้องการสร้างบัญชีผู้ใช้ประเภทอื่น ?
        <%= link_to "เลือกประเภท", users_role_path,
          class: "text-pink-500 font-medium hover:underline" %>
      </p>

    </div>
</div>