<div class="w-full max-w-5xl mx-auto px-4">
  <div class="mb-8">
    <h2 class="text-2xl font-semibold text-gray-900 mb-1">
      สร้างร้านค้าของคุณ
    </h2>
    <p class="text-sm text-gray-400 font-light">
      กรอกรายละเอียดร้านค้าเพื่อเริ่มขายสินค้า
    </p>
  </div>

  <%= form_with model: @store, url: seller_stores_path, local: true, html: { multipart: true } do |f| %>

    <% if @store.errors.any? %>
      <div class="mb-6 text-red-500 text-sm">
        <% @store.errors.full_messages.each do |msg| %>
          <div><%= msg %></div>
        <% end %>
      </div>
    <% end %>

    <div class="grid gap-6">

      <!-- STORE INFO -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border">
        <h3 class="text-lg font-medium mb-4">ข้อมูลร้านค้า</h3>

        <div class="mb-4">
          <%= f.label :cover, "รูปหน้าปก", class: "block mb-2" %>
          <%= f.file_field :cover, accept: "image/*", class: "w-full text-sm" %>
        </div>

        <div class="mb-4">
          <%= f.label :logo, "โลโก้ร้าน", class: "block mb-2" %>
          <%= f.file_field :logo, accept: "image/*", class: "w-full text-sm" %>
        </div>

        <div class="mb-4">
          <%= f.label :name, class: "block mb-2" do %>
            ชื่อร้าน <span class="text-red-500">*</span>
          <% end %>
          <%= f.text_field :name,
            required: true,
            placeholder: "กรอกชื่อร้าน",
            class: "w-full px-3 py-2.5 border rounded-lg" %>
        </div>

        <div class="mb-4">
          <%= f.label :description, "รายละเอียดร้าน", class: "block mb-2" %>
          <%= f.text_area :description,
            rows: 3,
            placeholder: "บอกรายละเอียดร้านของคุณ",
            class: "w-full px-3 py-2.5 border rounded-lg" %>
        </div>

        <div>
          <%= f.label :location, class: "block mb-2" do %>
            ที่ตั้งร้าน <span class="text-red-500">*</span>
          <% end %>
          <%= f.text_field :location,
            required: true,
            placeholder: "เช่น กรุงเทพฯ",
            class: "w-full px-3 py-2.5 border rounded-lg" %>
        </div>
      </div>

      <!-- BANK INFO -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border">
        <h3 class="text-lg font-medium mb-4">ข้อมูลบัญชีธนาคาร</h3>

        <div class="mb-4">
          <%= f.label :bank_code, class: "block mb-2" do %>
            ธนาคาร <span class="text-red-500">*</span>
          <% end %>
          <%= f.select :bank_code,
            [
              ["Bangkok Bank", "bbl"],
              ["Kasikorn Bank", "kbank"],
              ["SCB", "scb"],
              ["Krungthai", "ktb"],
              ["TTB", "ttb"]
            ],
            {},
            class: "w-full px-3 py-2 border rounded-lg" %>
        </div>

        <div class="mb-4">
          <%= f.label :bank_number, class: "block mb-2" do %>
            เลขบัญชี <span class="text-red-500">*</span>
          <% end %>
          <%= f.text_field :bank_number,
            required: true,
            placeholder: "เช่น 1234567890",
            class: "w-full px-3 py-2 border rounded-lg" %>
        </div>

        <div>
          <%= f.label :bank_name, class: "block mb-2" do %>
            ชื่อบัญชี <span class="text-red-500">*</span>
          <% end %>
          <%= f.text_field :bank_name,
            required: true,
            placeholder: "ชื่อบัญชีธนาคาร",
            class: "w-full px-3 py-2 border rounded-lg" %>
        </div>
      </div>

    </div>

    <div class="mt-8">
      <%= f.submit "สร้างร้านค้า",
        class: "w-full py-3.5 text-white text-base font-medium
                rounded-full
                bg-gradient-to-r from-pink-500 to-pink-600
                hover:opacity-90 active:scale-95 transition duration-200" %>
    </div>

  <% end %>
</div>