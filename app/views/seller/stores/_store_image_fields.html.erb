<%# locals: f:, store: %>
<%# Blob URLs need a persisted record; after failed create, cover may be "attached" in memory only. %>
<% cover_preview_url = store.persisted? && store.cover.attached? ? rails_blob_path(store.cover, only_path: true) : "" %>
<% logo_preview_url = store.persisted? && store.logo.attached? ? rails_blob_path(store.logo, only_path: true) : "" %>

<div class="mb-6"
     data-controller="store-image-upload"
     data-store-image-upload-max-bytes-value="10485760"
     data-store-image-upload-existing-url-value="<%= cover_preview_url %>">
    <div class="block text-base font-regular text-text-primary mb-2">
        รูปหน้าปกร้านค้า <span class="text-text-accents-red">*</span>
    </div>

    <%= f.file_field :cover,
          accept: "image/jpeg,image/png,.jpg,.jpeg,.png",
          class: "sr-only",
          data: {
            store_image_upload_target: "input",
            action: "change->store-image-upload#picked"
          } %>

    <label for="<%= f.field_id(:cover) %>"
           class="block cursor-pointer rounded-xl border-2 border-dashed border-border-neutral bg-neutral-50 hover:bg-gray-50 transition-colors overflow-hidden">
        <div data-store-image-upload-target="empty"
             class="flex flex-col items-center justify-center gap-2 px-4 py-10 min-h-[10rem]">
            <svg class="w-10 h-10 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3A1.5 1.5 0 0 0 1.5 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
            <span class="text-xs text-text-blue font-semibold">คลิกเพื่ออัปโหลดรูปหน้าปก</span>
            <span class="text-xs text-text-neutral-300 text-center leading-relaxed">รองรับไฟล์ JPG, JPEG, PNG ขนาดไม่เกิน 10MB</span>
        </div>
        <%= tag.img alt: "",
              class: "hidden w-full h-40 md:h-44 object-cover",
              data: { store_image_upload_target: "preview" } %>
    </label>
    <p data-store-image-upload-target="error" class="hidden text-xs text-text-accents-red mt-2" role="alert"></p>
</div>

<div class="mb-6"
     data-controller="store-image-upload"
     data-store-image-upload-max-bytes-value="10485760"
     data-store-image-upload-existing-url-value="<%= logo_preview_url %>">
    <div class="block text-base font-regular text-text-primary mb-2">
        รูปโปรไฟล์ร้านค้า <span class="text-text-accents-red">*</span>
    </div>

    <%= f.file_field :logo,
          accept: "image/jpeg,image/png,.jpg,.jpeg,.png",
          class: "sr-only",
          data: {
            store_image_upload_target: "input",
            action: "change->store-image-upload#picked"
          } %>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-[auto_1fr] sm:items-start">
        <label for="<%= f.field_id(:logo) %>"
               class="block aspect-square w-28 shrink-0 rounded-full border-2 border-dashed border-border-neutral bg-neutral-50 overflow-hidden cursor-pointer hover:bg-gray-50 transition-colors sm:w-32">
            <div data-store-image-upload-target="empty"
                 class="w-full h-full flex items-center justify-center">
                <svg class="w-10 h-10 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3A1.5 1.5 0 0 0 1.5 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                </svg>
            </div>
            <%= tag.img alt: "",
                  class: "hidden w-full h-full object-cover rounded-full",
                  data: { store_image_upload_target: "preview" } %>
        </label>
        <div class="flex flex-1 flex-col gap-3">
            <p data-store-image-upload-target="nameLabel" class="text-sm text-text-primary truncate">
                <%= store.logo.attached? ? store.logo.filename.to_s : "ยังไม่ได้เลือกไฟล์" %>
            </p>
            <button type="button"
                    data-action="click->store-image-upload#open"
                    class="inline-flex w-fit shrink-0 items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-white text-sm font-semibold bg-Primary-color shadow-sm hover:opacity-90 active:scale-[0.99] transition">
                <svg class="w-5 h-5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                </svg>
                อัปโหลดรูปภาพ
            </button>
        </div>
    </div>
    <p data-store-image-upload-target="error" class="hidden text-xs text-text-accents-red mt-2" role="alert"></p>
</div>
