
<div class="flex items-start gap-3 mb-6">
  <%= link_to seller_root_path,

            class: "inline-flex shrink-0 -ml-1 mt-0.5 p-1 text-gray-900 hover:opacity-70 active:opacity-60 transition-opacity",
            aria: { label: "กลับ" } do %>
    <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
    </svg>
  <% end %>
  <div>
    <h2 class="text-2xl font-semibold text-gray-900 mb-1">
      แก้ไขโปรไฟล์ร้านค้า
    </h2>
    <p class="text-sm text-gray-400 font-light">
      กรอกรายละเอียดร้านค้าเพื่ออัปเดตข้อมูลของคุณ
    </p>
  </div>
</div>
<%= form_with model: @store, url: seller_store_path(@store), local: true, method: :patch, html: { multipart: true } do |f| %>
  <% if @store.errors.any? %>
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
      <% @store.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>
  <div class="grid gap-4">
    <div class="mb-6">
      <%= render "store_image_fields", f: f, store: @store %>
      <div class="mb-4">
        <%= f.label :name,
            class: "block text-base font-regular text-text-primary mb-2" do %>
          ชื่อร้าน <span class="text-text-accents-red">*</span>
        <% end %>
        <%= f.text_field :name,
            required: true,
            placeholder: "กรอกชื่อร้าน",
            class: "w-full px-3 py-2.5 text-sm text-text-primary
                    bg-white border border-border-neutral rounded-lg
                    placeholder:text-text-placeholder
                    focus:border-Primary-color focus:outline-none" %>
      </div>
      <div class="mb-4">
        <%= f.label :description, "รายละเอียดร้าน",
            class: "block text-base font-regular text-text-primary mb-2" %>
        <%= f.text_area :description,
            rows: 3,
            placeholder: "บอกรายละเอียดร้านของคุณ",
            class: "w-full px-3 py-2.5 text-sm text-text-primary
                    bg-white border border-border-neutral rounded-lg
                    placeholder:text-text-placeholder
                    focus:border-Primary-color focus:outline-none" %>
      </div>
      <div>
        <%= f.label :location,
            class: "block text-base font-regular text-text-primary mb-2" do %>
          ที่ตั้งร้าน <span class="text-text-accents-red">*</span>
        <% end %>
        <%= f.text_field :location,
            required: true,
            placeholder: "เช่น กรุงเทพฯ",
            class: "w-full px-3 py-2.5 text-sm text-text-primary
                    bg-white border border-border-neutral rounded-lg
                    placeholder:text-text-placeholder
                    focus:border-Primary-color focus:outline-none" %>
      </div>
    </div>
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-border-neutral">
      <h3 class="text-base font-semibold text-text-primary mb-4">ข้อมูลบัญชีธนาคาร</h3>
      <div class="mb-4">
        <%= f.label :bank_code, class: "block text-base font-regular text-text-primary mb-2" do %>
          ธนาคาร <span class="text-text-accents-red">*</span>
        <% end %>
        <div class="relative">
          <%= f.select :bank_code,
                [
                    ["Bangkok Bank", "bbl"],
                    ["Kasikorn Bank", "kbank"],
                    ["SCB", "scb"],
                    ["Krungthai", "ktb"],
                    ["TTB", "ttb"]
                ],
                { prompt: "เลือกธนาคาร" },
                required: true,
                class: "appearance-none w-full px-3 py-2.5 text-sm
                        text-gray-400
                        bg-white border border-border-neutral rounded-lg
                        focus:border-Primary-color focus:outline-none
                        invalid:text-gray-400 valid:text-gray-900" %>
          <div class="pointer-events-none absolute inset-y-0 right-5 flex items-center">
            <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="2"
                    viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </div>
      </div>
      <div class="mb-4">
        <%= f.label :bank_number,
            class: "block text-base font-regular text-text-primary mb-2" do %>
          เลขบัญชี <span class="text-text-accents-red">*</span>
        <% end %>
        <%= f.text_field :bank_number,
            required: true,
            placeholder: "เช่น 1234567890",
            inputmode: "numeric",
            pattern: "\\d{9,12}",
            title: "ตัวเลข 9–12 หลัก",
            class: "w-full px-3 py-2.5 text-sm text-text-primary
                    bg-white border border-border-neutral rounded-lg
                    placeholder:text-text-placeholder
                    focus:border-Primary-color focus:outline-none" %>
        <p class="mt-1 text-xs text-text-neutral-300">ตัวเลข 9–12 หลัก (ไม่มีขีดหรือเว้นวรรค)</p>
      </div>
      <div>
        <%= f.label :bank_name,
            class: "block text-base font-regular text-text-primary mb-2" do %>
          ชื่อบัญชี <span class="text-text-accents-red">*</span>
        <% end %>
        <%= f.text_field :bank_name,
            required: true,
            placeholder: "ชื่อบัญชีธนาคาร",
            class: "w-full px-3 py-2.5 text-sm text-text-primary
                    bg-white border border-border-neutral rounded-lg
                    placeholder:text-text-placeholder
                    focus:border-Primary-color focus:outline-none" %>
      </div>
    </div>
  </div>
  <div class="mt-6">
    <%= f.submit "บันทึกการเปลี่ยนแปลง",
        class: "w-full py-3.5 text-white text-base font-medium
                rounded-full
                bg-gradient-to-r from-pink-500 to-pink-600
                shadow-lg shadow-pink-200
                hover:opacity-90 active:scale-95
                transition duration-200" %>
  </div>
<% end %>
