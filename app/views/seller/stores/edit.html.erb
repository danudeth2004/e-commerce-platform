<div class="w-full max-w-md md:max-w-2xl mx-auto px-4">
    <div class="flex items-start gap-3 mb-6">
        <%= link_to seller_root_path,
      class: "inline-flex items-center justify-center w-9 h-9 rounded-full hover:bg-gray-100 shrink-0 mt-1" do %>
        <span class="text-xl leading-none text-gray-700">‹</span>
        <% end %>

        <div>
            <h1 class="text-lg md:text-xl font-semibold text-gray-900 mb-1">
                แก้ไขโปรไฟล์ร้านค้า
            </h1>
            <p class="text-xs md:text-sm text-gray-400">
                ปรับข้อมูลร้านค้าของคุณ เช่น ชื่อ, โลโก้, รูปหน้าปก และบัญชีธนาคาร
            </p>
        </div>
    </div>

    <% input_class = "w-full px-3 py-2.5 text-sm text-text-primary bg-white border border-border-neutral rounded-lg placeholder:text-text-placeholder focus:border-Primary-color focus:outline-none" %>

    <%= form_with model: @store, url: seller_store_path(@store), local: true, method: :patch, html: { multipart: true } do |f| %>

    <%
=begin%>
 <% if @store.errors.any? %>
    <div class="mb-6 text-red-500 text-sm">
        <% @store.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
        <% end %>
    </div>
    <% end %> 
<%
=end%>

    <div class="grid gap-6">

        <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-border-neutral">
            <h3 class="text-base md:text-lg font-medium mb-4">ข้อมูลร้านค้า</h3>

            <div class="mb-4">
                <%= f.label :cover, "รูปหน้าปก",
            class: "block text-base text-text-primary mb-2" %>

                <%= f.file_field :cover,
            accept: "image/*",
            class: "w-full text-sm text-text-primary" %>

                <% if @store.cover.attached? %>
                <%= image_tag rails_blob_path(@store.cover, only_path: true),
              class: "mt-3 w-full h-32 md:h-40 object-cover rounded-lg border border-border-neutral" %>
                <% end %>
            </div>

            <div class="mb-4">
                <%= f.label :logo, "โลโก้ร้าน",
            class: "block text-base text-text-primary mb-2" %>

                <%= f.file_field :logo,
            accept: "image/*",
            class: "w-full text-sm text-text-primary" %>

                <% if @store.logo.attached? %>
                <%= image_tag rails_blob_path(@store.logo, only_path: true),
              class: "mt-3 w-20 h-20 object-cover rounded-full border border-border-neutral" %>
                <% end %>
            </div>

            <div class="mb-4">
                <%= f.label :name,
            class: "block text-base text-text-primary mb-2" do %>
                ชื่อร้าน <span class="text-red-500">*</span>
                <% end %>

                <%= f.text_field :name,
            required: true,
            placeholder: "กรอกชื่อร้าน",
            class: input_class %>
            </div>

            <div class="mb-4">
                <%= f.label :description, "รายละเอียดร้าน",
            class: "block text-base text-text-primary mb-2" %>

                <%= f.text_area :description,
            rows: 3,
            placeholder: "บอกรายละเอียดร้านของคุณ",
            class: input_class %>
            </div>

            <div>
                <%= f.label :location,
            class: "block text-base text-text-primary mb-2" do %>
                ที่ตั้งร้าน <span class="text-red-500">*</span>
                <% end %>

                <%= f.text_field :location,
            required: true,
            placeholder: "เช่น กรุงเทพฯ",
            class: input_class %>
            </div>
        </div>

        <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-border-neutral">
            <h3 class="text-base md:text-lg font-medium mb-4">ข้อมูลบัญชีธนาคาร</h3>

            <div class="mb-4">
                <%= f.label :bank_code,
            class: "block text-base text-text-primary mb-2" do %>
                ธนาคาร <span class="text-red-500">*</span>
                <% end %>

                <%= f.select :bank_code,
            [
              ["Bangkok Bank", "bbl"],
              ["Kasikorn Bank", "kbank"],
              ["SCB", "scb"],
              ["Krungthai", "ktb"],
              ["TTB", "ttb"]
            ],
            {},
            class: input_class %>
            </div>

            <div class="mb-4">
                <%= f.label :bank_number,
            class: "block text-base text-text-primary mb-2" do %>
                เลขบัญชี <span class="text-red-500">*</span>
                <% end %>

                <%= f.text_field :bank_number,
            required: true,
            placeholder: "เช่น 1234567890",
            class: input_class %>
            </div>

            <div>
                <%= f.label :bank_name,
            class: "block text-base text-text-primary mb-2" do %>
                ชื่อบัญชี <span class="text-red-500">*</span>
                <% end %>

                <%= f.text_field :bank_name,
            required: true,
            placeholder: "ชื่อบัญชีธนาคาร",
            class: input_class %>
            </div>
        </div>

    </div>

    <div class="mt-8">
        <%= f.submit "บันทึกการเปลี่ยนแปลง",
        class: "w-full py-3.5 text-white text-base font-medium
                rounded-full
                bg-gradient-to-r from-pink-500 to-pink-600
                shadow-lg shadow-pink-200
                hover:opacity-90 active:scale-95
                transition duration-200" %>
    </div>

    <% end %>
</div>