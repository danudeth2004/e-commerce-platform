<div class="w-full min-h-screen bg-white">
  <div class="w-full max-w-screen-xl mx-auto space-y-8 pb-6 pt-7 px-4">
    <%= form_with url: seller_root_path, method: :get, local: true, class: "w-full min-w-0", role: "search" do %>
      <div class="relative flex items-center">
        <label for="header-search-q" class="sr-only">ค้นหาสินค้า</label>
        <span class="pointer-events-none absolute left-3.5 flex text-gray-400" aria-hidden="true">
          <%= inline_svg_tag "icons/search-icon.svg", class: "w-[18px] h-[18px]" %>
        </span>
        <%= text_field_tag :q, params[:q],
                  id: "header-search-q",
                  placeholder: "ค้นหาสินค้า...",
                  autocomplete: "off",
                  class: "w-full rounded-full border border-gray-200 bg-white py-2.5 pl-10 pr-4 text-sm text-gray-800 placeholder:text-gray-400 shadow-sm focus:border-pink-300 focus:outline-none focus:ring-2 focus:ring-pink-200/60" %>
      </div>
    <% end %>
    <section class="bg-white rounded-2xl shadow-sm">
      <div class="relative">
        <div class="bg-gray-200 h-44 w-full">
          <% if @store.cover.attached? %>
            <%= image_tag rails_blob_path(@store.cover, only_path: true),
              class: "w-full h-full object-cover",
              alt: @store.name,
              loading: "lazy" %>
          <% end %>
        </div>
        <div class="absolute top-2 right-2 group">
          <% if @store.active? %>
            <span class="px-2 py-1 text-[10px] font-medium rounded-full bg-green-100 text-green-700 cursor-default">
              พร้อมใช้งาน
            </span>
          <% elsif @store.inactive? %>
            <span class="px-2 py-1 text-[10px] font-medium rounded-full bg-yellow-100 text-yellow-700 cursor-default">
              รอการตรวจสอบ
            </span>
          <% elsif @store.suspended? %>
            <span class="px-2 py-1 text-[10px] font-medium rounded-full bg-red-100 text-red-700 cursor-default">
              ถูกระงับ
            </span>
          <% end %>
          <div class="absolute right-0 top-full mt-2 w-max max-w-[220px]
            opacity-0 group-hover:opacity-100 transition-opacity duration-200
            pointer-events-none z-10">
            <div class="bg-gray-800 text-white text-[10px] rounded-md px-2 py-1 relative">
              <div class="absolute -top-1 right-2 w-2 h-2 bg-gray-800 rotate-45"></div>
              <% if @store.active? %>
                ร้านของคุณเปิดขายได้ตามปกติ ลูกค้าสามารถสั่งซื้อสินค้าได้
              <% elsif @store.inactive? %>
                ร้านค้ากำลังรอการตรวจสอบโดยผู้ดูแลระบบ แต่สามารถปรับแต่งร้านค้าของคุณได้ตามปกติ
              <% elsif @store.suspended? %>
                ร้านค้าถูกระงับการใช้งาน กรุณาติดต่อผู้ดูแลระบบ
              <% end %>
            </div>
          </div>
        </div>
        <div class="absolute -bottom-12 left-8 w-28 h-28 rounded-full bg-white p-1 shadow-sm">
          <div class="w-full h-full rounded-full overflow-hidden border border-gray-200">
            <% if @store.logo.attached? %>
              <%= image_tag rails_blob_path(@store.logo, only_path: true),
                class: "w-full h-full object-cover",
                alt: @store.name,
                loading: "lazy" %>
            <% end %>
          </div>
        </div>
      </div>
      <div class="pt-16 pb-6 px-6 flex flex-col md:flex-row md:justify-between md:items-start gap-6">
        <div class="w-full">
          <div class="flex items-center justify-between">
            <div class="flex-1 pr-6">
              <h1 class="text-xl md:text-2xl font-semibold text-gray-900 break-words">
                <%= @store.name %>
              </h1>
            </div>
            <div class="relative shrink-0" data-controller="menu">
              <button type="button" class="flex items-center justify-center w-10 h-10 rounded-full bg-white shadow-sm border border-gray-200" data-action="click->menu#toggle">
                <span class="flex flex-col gap-[2px]">
                  <span class="w-[3px] h-[3px] rounded-full bg-gray-700"></span>
                  <span class="w-[3px] h-[3px] rounded-full bg-gray-700"></span>
                  <span class="w-[3px] h-[3px] rounded-full bg-gray-700"></span>
                </span>
              </button>
              <div class="hidden absolute right-0 z-50 mt-2 w-48 rounded-xl border border-gray-100 bg-white py-1 text-sm shadow-lg ring-1 ring-black/5" data-menu-target="panel">
                <%= link_to edit_seller_store_path(@store),
                  class: "block px-4 py-2.5 text-gray-800 hover:bg-gray-50" do %>
                  แก้ไขโปรไฟล์ร้านค้า
                <% end %>
                <%= link_to seller_orders_path,
                  class: "block px-4 py-2.5 text-gray-800 hover:bg-gray-50" do %>
                  คำสั่งซื้อจากลูกค้า
                <% end %>
                <%= link_to seller_sales_path,
                  class: "block px-4 py-2.5 text-gray-800 hover:bg-gray-50" do %>
                  รายรับและประวัติการขาย
                <% end %>
                <%= link_to choose_seller_products_path,
                  class: "block px-4 py-2.5 text-gray-800 hover:bg-gray-50" do %>
                  เพิ่มสินค้า / จัดเซต
                <% end %>
                <% if seller_user_signed_in? %>
                  <%= button_to destroy_seller_user_session_path,
                        method: :delete,
                        class: "w-full border-t border-gray-100 text-left" do %>
                    <span class="flex items-center gap-2 px-4 py-2.5 text-red-600 hover:bg-red-50">
                      <span class="iconify" data-icon="lucide:log-out" data-width="16"></span>
                      <span>ออกจากระบบ</span>
                    </span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
          <p class="mt-2 text-sm text-gray-500">
            <%= @store.description.presence || "สร้างคำอธิบายร้านค้าแบบสั้น ๆ เพื่อบอกสไตล์ จุดเด่น และบริการของคุณให้ลูกค้าเข้าใจได้ง่ายขึ้น" %>
          </p>
        </div>
      </div>
    </section>
    <%= turbo_frame_tag "products_frame" do %>
      <% if @store.persisted? && @store.products.exists? %>
        <div class="space-y-8 mt-4">
          <% if @bundle_products.any? %>
            <section class="space-y-3">
              <div class="rounded-2xl border border-pink-100/80 bg-gradient-to-br from-pink-50/90 to-white px-4 py-3">
                <p class="text-xs font-semibold uppercase tracking-wide text-pink-600">เซตสินค้า</p>
                <h2 class="text-base font-bold text-gray-900 mt-0.5">ตัวอย่างหน้าลูกค้า — จัดชุดมาให้แล้ว</h2>
                <p class="text-xs text-gray-500 mt-1">ลูกค้าเห็นราคาเซตและสินค้าในชุดแบบนี้</p>
              </div>
              <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
                <% @bundle_products.each do |product| %>
                  <%= render "shared/product_bundle_card",
                     product: product_to_card_hash(product),
                     show_cart: false,
                     full_width: true,
                     link_to_path: product_path(product, seller_preview: 1) %>
                <% end %>
              </div>
            </section>
          <% end %>
          <% if @standard_products.any? %>
            <section class="space-y-3">
              <h2 class="text-base font-semibold text-gray-900">
                <%= @bundle_products.any? ? "สินค้าชิ้นเดียว" : "สินค้าทั้งหมด" %>
              </h2>
              <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
                <% @standard_products.each do |product| %>
                  <%= render "shared/product_card",
                     product: product_to_card_hash(product),
                     show_cart: false,
                     full_width: true,
                     link_to_path: product_path(product, seller_preview: 1) %>
                <% end %>
              </div>
            </section>
          <% end %>
          <% if @bundle_products.empty? && @standard_products.empty? %>
            <p class="text-center text-sm text-gray-500 py-8">ไม่มีสินค้าในร้านค้าของคุณ</p>
          <% end %>
        </div>
      <% else %>
        <section class="flex flex-col items-center text-center text-sm text-gray-500 py-16 space-y-2">
          <%= image_tag "empty_product.png", class: "w-36 h-36" %>
          <p class="font-medium text-gray-700">ยังไม่มีสินค้าในร้านค้าของคุณ</p>
          <p>เพิ่มสินค้าชิ้นแรกของคุณในร้านค้าได้ที่นี่</p>
        </section>
      <% end %>
    <% end %>
  </div>
</div>
