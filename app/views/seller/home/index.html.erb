<div class="w-full max-w-sm mx-auto">
  <section class="bg-white rounded-2xl shadow-sm">
    <div class="relative">
      <div class="bg-gray-200 h-28 w-full"></div>
      <div class="absolute -bottom-7 left-5">
        <div class="w-14 h-14 rounded-full bg-white">
          <div class="w-full h-full rounded-full bg-gray-300 border border-gray-200"></div>
        </div>
      </div>
    </div>

    <div class="pt-9 px-5 pb-4">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h1 class="text-sm font-semibold text-gray-900">
            <%= @store.name %>
          </h1>
          <p class="mt-1 text-[11px] leading-snug text-gray-500">
            สร้างคำอธิบายร้านค้าแบบสั้น ๆ เพื่อบอกสไตล์ จุดเด่น และบริการของคุณให้ลูกค้าเข้าใจได้ง่ายขึ้น
          </p>
        </div>

        <div class="relative" data-controller="menu">
          <button
            type="button"
            class="mt-1 flex items-center justify-center w-7 h-7 rounded-full bg-white shadow-sm border border-gray-200"
            data-action="click->menu#toggle"
          >
            <span class="flex flex-col gap-[2px]">
              <span class="w-[3px] h-[3px] rounded-full bg-gray-700"></span>
              <span class="w-[3px] h-[3px] rounded-full bg-gray-700"></span>
              <span class="w-[3px] h-[3px] rounded-full bg-gray-700"></span>
            </span>
          </button>

          <div
            class="hidden absolute right-0 mt-1 w-40 rounded-xl shadow-lg bg-white ring-1 ring-black/5 py-1 text-xs"
            data-menu-target="panel"
          >
            <%= button_tag type: "button", class: "w-full text-left block px-4 py-2 text-gray-800 hover:bg-gray-50" do %>
              แก้ไขโปรไฟล์ร้านค้า
            <% end %>
            <%= link_to new_seller_product_path,
                        class: "block px-4 py-2 text-gray-800 hover:bg-gray-50 text-left w-full" do %>
              เพิ่มสินค้า
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <% if @store.persisted? && @store.products.exists? %>
    <section class="mt-5 space-y-3">
      <%= render "shared/product_category_filter",
                 current_category_key: @category_key,
                 path_proc: ->(key) { key.present? ? seller_root_path(category: key) : seller_root_path } %>
      <% if @products.any? %>
        <div class="grid grid-cols-2 gap-3">
          <% @products.each do |product| %>
            <%= render "shared/product_card",
                       product: {
                         id: product.id,
                         name: product.title,
                         desc: product.description.to_s,
                         price: product.amount_cents / 100,
                         original_price: nil,
                         image_url: (product.images.attached? ? url_for(product.images.first) : nil),
                         discount_percent: nil
                       },
                       show_cart: false,
                       full_width: true %>
          <% end %>
        </div>
      <% else %>
        <p class="text-center text-xs text-gray-500 py-8">ไม่มีสินค้าในหมวดนี้</p>
      <% end %>
    </section>
  <% else %>
    <section class="mt-16 flex flex-col items-center text-center text-xs text-gray-500">
      <%= image_tag "empty_product.png", class: "w-28 h-28 mb-4" %>
      <p class="font-medium text-gray-700">
        ยังไม่มีสินค้าในร้านค้าของคุณ
      </p>
      <p class="mt-1 text-[11px]">
        เพิ่มสินค้าชิ้นแรกของคุณในร้านค้าได้ที่นี่
      </p>
    </section>
  <% end %>
</div>
