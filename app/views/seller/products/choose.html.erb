<div class="w-full max-w-md mx-auto">
  <div class="flex items-center gap-3 mb-4">
    <%= link_to seller_root_path, class: "inline-flex items-center justify-center w-9 h-9 rounded-full hover:bg-gray-100" do %>
      <span class="text-xl leading-none text-gray-700">‹</span>
    <% end %>
    <div class="flex-1">
      <h1 class="text-lg font-semibold text-gray-900 mb-1">
        เพิ่มรายการสินค้าของคุณ
      </h1>
      <p class="text-xs text-[#A9A9A9]">
        กรอกรายละเอียดของสินค้าให้ครบ
      </p>
    </div>
  </div>

  <% bundle_ready = @store.products.standard.size >= 2 %>

  <div class="space-y-4">
    <%= link_to new_seller_product_path,
      class: "block rounded-2xl border border-gray-200 bg-white p-4 shadow-sm hover:border-[#FF1493]/40 transition" do %>
      <div class="flex gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-pink-100 text-sm font-semibold text-[#FF1493]">
          1
        </div>
        <div>
          <p class="font-semibold text-gray-900">เพิ่มสินค้าชิ้นเดียว</p>
          <p class="mt-1 text-xs text-gray-500">เพิ่มสินค้าใหม่เข้าสู่ร้านของคุณ</p>
        </div>
      </div>
    <% end %>

    <% if bundle_ready %>
      <%= link_to new_seller_product_bundle_path,
        class: "block rounded-2xl border border-gray-200 bg-white p-4 shadow-sm hover:border-[#FF1493]/40 transition" do %>
        <div class="flex gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-pink-100 text-sm font-semibold text-[#FF1493]">
            2
          </div>
          <div>
            <p class="font-semibold text-gray-900">จัดเซตสินค้า</p>
            <p class="mt-1 text-xs text-gray-500">จัดกลุ่มสินค้าที่มีอยู่เป็นเซตตามการใช้งาน (เช่น แชมพู + ครีมนวดผม)</p>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-2xl border border-dashed border-gray-200 bg-gray-50/80 p-4">
        <div class="flex gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gray-200 text-sm font-semibold text-gray-500">
            2
          </div>
          <div class="flex-1">
            <p class="font-semibold text-gray-700">จัดเซตสินค้า</p>
            <p class="mt-1 text-xs text-gray-500">
              ต้องมีสินค้าชิ้นเดียวในร้านอย่างน้อย <strong class="text-gray-700">2 รายการ</strong> ก่อน — เพิ่มสินค้าก่อนแล้วค่อยกลับมาจัดเซตได้
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <%= link_to "ไปเพิ่มสินค้าชิ้นเดียว",
                new_seller_product_path,
                class: "inline-flex items-center rounded-full bg-[#FF1493] px-4 py-2 text-xs font-semibold text-white hover:opacity-95" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <p class="mt-8 text-center text-xs text-gray-400">
    <%= link_to "กลับหน้าร้านของฉัน", seller_root_path, class: "text-[#FF1493] font-medium hover:underline" %>
  </p>
</div>
