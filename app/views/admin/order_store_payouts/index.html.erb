<div class="bg-white shadow rounded-lg p-6">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold text-gray-900">การโอนเงินให้ร้าน</h1>
  </div>

  <%
=begin%>
 <p class="text-sm text-gray-600 mb-6">
    รายการล่าสุด 200 รายการ (เรียงตามเวลาอัปเดต) — ดูรายละเอียดหรือสั่งโอนเมื่อสถานะเป็นรอดำเนินการ
  </p> 
<%
=end%>

  <div class="flex items-center justify-end mb-4">
    <%= form_with url: admin_order_store_payouts_path, method: :get, local: true do |f| %>
      <%= f.select :status,
          options_for_select([["All", ""], "Failed", "Pending", "Processing", "Transferred"], params[:status]),
          {},
          class: "rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:outline-none transition-colors duration-200"
      %>
      <%= f.submit "Filter",
          class: "ml-2 rounded-lg bg-blue-600 px-3 py-2 text-white text-sm font-medium hover:bg-blue-700 shadow-sm transition-colors duration-200"
      %>
    <% end %>
  </div>

  <% if @payouts.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 border">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">รหัส</th>
            <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">คำสั่งซื้อ</th>
            <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">ร้าน</th>
            <th class="px-4 py-2 text-right text-sm font-semibold text-gray-700">จำนวนเงิน</th>
            <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">สถานะ</th>
            <th class="px-4 py-2 text-center text-sm font-semibold text-gray-700"></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @payouts.each do |p| %>
            <tr class="hover:bg-gray-50 transition">
              <td class="px-4 py-2 text-sm text-gray-800">#<%= p.id %></td>
              <td class="px-4 py-2 text-sm text-gray-800">#<%= p.order_id %></td>
              <td class="px-4 py-2 text-sm text-gray-800"><%= p.store.name %></td>
              <td class="px-4 py-2 text-sm text-gray-800 text-right"><%= number_with_delimiter(p.amount) %> ฿</td>
              <td class="px-4 py-2 text-sm font-medium text-gray-900"><%= p.status.humanize %></td>
              <td class="px-4 py-2 text-center">
                <%= link_to "ดูรายละเอียด", admin_order_store_payout_path(p), class: "text-blue-600 hover:underline text-sm font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500">ยังไม่มีรายการโอนเงิน</p>
  <% end %>
</div>
