<div class="min-h-screen flex items-center justify-center bg-gray-100">
  <div class="w-full min-w-md bg-white rounded-2xl shadow-lg p-8">
    <h2 class="text-2xl font-semibold text-center text-gray-800 mb-6">
      เข้าสู่ระบบแอดมิน
    </h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }) do |f| %>
      <div class="mb-4">
        <%= f.label :email, "ที่อยู่อีเมล", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email,
          autofocus: true,
          placeholder: "example@domain.com",
          autocomplete: "email",
          class: "w-full rounded-lg border-gray-300 border border-gray-500 px-2 py-2" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "รหัสผ่าน", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password,
          placeholder: "รหัสผ่าน",
          autocomplete: "current-password",
          class: "w-full rounded-lg border-gray-300 border border-gray-500 px-2 py-2" %>
      </div>

      <div>
        <%= f.submit "เข้าสู่ระบบ",
          class: "w-full bg-indigo-600 text-white mt-4 py-2 px-4 rounded-lg font-medium
                  hover:bg-indigo-700 transition duration-200" %>
      </div>

    <% end %>
  </div>
</div>


