<div class="bg-white shadow rounded-lg p-6 space-y-6">
  <div class="flex justify-between items-start">
    <div class="flex flex-col gap-4">
      <%= link_to "← กลับไปหน้าร้านค้า", admin_stores_path, class: "text-sm font-medium text-blue-600 hover:text-blue-800" %>

      <div class="flex items-center gap-6">
        <% if @store.logo.attached? %>
          <img src="<%= url_for(@store.logo) %>" alt="Logo" class="w-32 h-32 object-cover rounded-full border">
        <% else %>
          <div class="w-32 h-32 bg-gray-200 rounded-full border flex items-center justify-center text-gray-400">Logo</div>
        <% end %>

        <div class="space-y-2">
          <h2 class="text-2xl font-bold text-gray-900"><%= @store.name %></h2>
          <p class="text-gray-600"><%= @store.description %></p>
          <p class="text-gray-600">Location: <%= @store.location %></p>
          <p class="text-gray-600">
            Owner: <%= @store.owner.first_name %> <%= @store.owner.last_name %> |
            Phone: <%= @store.owner.phone_number %> |
            Email: <%= @store.owner.email %>
          </p>
        </div>
      </div>
    </div>

    <div>
      <%= form_with url: toggle_status_admin_store_path(@store), method: :patch, class: "inline-block" do %>
        <label class="relative inline-flex items-center cursor-pointer">
          <%= check_box_tag :status, "1", @store.active?, class: "sr-only peer", onchange: "this.form.requestSubmit();" %>
          <div class="w-14 h-7 bg-gray-300 rounded-full peer-checked:bg-green-500 transition-colors"></div>
          <div class="absolute left-0.5 top-0.5 w-6 h-6 bg-white rounded-full shadow-md transition-transform peer-checked:translate-x-7"></div>
        </label>
      <% end %>
    </div>
  </div>

  <div class="mt-6">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-xl font-bold">Omise Payouts</h3>

      <%= form_with url: admin_store_path(@store), method: :get, local: true do %>
        <select name="status" onchange="this.form.submit()" class="border rounded-md px-2 py-1 text-sm">
          <option value="all" <%= "selected" if @selected_status == "all" %>>All</option>
          <% %w[pending processing transferred].each do |s| %>
            <option value="<%= s %>" <%= "selected" if @selected_status == s %>><%= s.capitalize %></option>
          <% end %>
        </select>
      <% end %>
    </div>

    <% if @payouts.any? %>
      <table class="min-w-full divide-y divide-gray-200 border">
        <thead class="bg-gray-50">
            <tr>
            <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">รหัสการโอน</th>
            <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Omise Recipient ID</th>
            <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">จำนวนเงิน</th>
            <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">สถานะ</th>
            <th class="px-4 py-2 text-center text-sm font-semibold text-gray-700">Action</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
            <% @payouts.each do |p| %>
            <tr class="hover:bg-gray-50 transition">
                <td class="px-4 py-2 text-sm text-gray-800"><%= p.transfer_id || "-" %></td>
                <td class="px-4 py-2 text-sm text-gray-800"><%= @store.omise_recipient_id %></td>
                <td class="px-4 py-2 text-sm text-gray-800">฿ <%= number_with_delimiter(p.amount_cents / 100) %></td>
                <td class="px-4 py-2 text-sm text-gray-800 font-bold"><%= p.status.capitalize %></td>
                <td class="px-4 py-2 text-center">
                <% if p.status == "processing" %>
  <%= form_with url: omise_transfer_admin_store_payout_path(@store, p), method: :post, local: true do %>
    <%= submit_tag "โอนเงิน", class: "ml-2 px-2 py-1 bg-green-500 text-white rounded hover:bg-green-600" %>
  <% end %>
<% end %>
                </td>
            </tr>
            <% end %>
        </tbody>
        </table>
    <% else %>
      <p class="text-gray-500">ไม่มี payouts สำหรับสถานะนี้</p>
    <% end %>
  </div>
</div>