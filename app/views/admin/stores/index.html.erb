<div class="w-full bg-white shadow rounded-lg p-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">ร้านค้า (Seller)</h1>
      <p class="text-sm text-gray-500 mt-1">ค้นหาจากชื่อร้าน อีเมลหรือชื่อเจ้าของ</p>
    </div>
    <%= form_with url: admin_stores_path, method: :get, local: true, class: "flex flex-wrap items-center gap-2" do %>
      <%= text_field_tag :q, params[:q], placeholder: "ค้นหา…", class: "rounded-lg border border-gray-300 px-3 py-2 text-sm min-w-[12rem]" %>
      <%= submit_tag "ค้นหา", class: "rounded-lg bg-slate-700 text-white px-4 py-2 text-sm font-medium hover:bg-slate-800" %>
      <% if params[:q].present? %>
        <%= link_to "ล้าง", admin_stores_path, class: "text-sm text-blue-600 hover:underline" %>
      <% end %>
    <% end %>
  </div>

  <table class="w-full divide-y divide-gray-200 border">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">ID</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">ชื่อร้าน</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">เจ้าของร้าน</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">อีเมล</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">สร้างเมื่อ</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">สถานะ</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-100">
      <% @stores.each do |store| %>
        <tr class="hover:bg-gray-50 transition cursor-pointer"
            onclick="window.location='<%= admin_store_path(store) %>'">
          <td class="px-4 py-2 text-sm text-gray-800"><%= store.id %></td>
          <td class="px-4 py-2 text-sm text-gray-800"><%= store.name %></td>
          <td class="px-4 py-2 text-sm text-gray-800"><%= store.owner.first_name %> <%= store.owner.last_name %></td>
          <td class="px-4 py-2 text-sm text-gray-800"><%= store.owner.email %></td>
          <td class="px-4 py-2 text-sm text-gray-800"><%= store.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td class="px-4 py-2 text-sm text-gray-800" onClick="event.stopPropagation();">
            <%= form_with url: set_status_admin_store_path(store), method: :patch, class: "inline" do %>
              <%= select_tag :status,
                    options_for_select(admin_store_status_options, store.status),
                    class: "rounded-md border border-gray-300 text-sm py-1.5 pl-2 pr-8 max-w-[11rem]",
                    onchange: "this.form.requestSubmit();" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @stores.empty? %>
    <p class="text-gray-500 mt-4">ไม่มีร้านค้าในระบบ</p>
  <% end %>
</div>
