<div class="bg-white shadow rounded-lg p-6">
  <h1 class="text-2xl font-bold text-gray-900 mb-4">ร้านค้า</h1>

  <table class="min-w-full divide-y divide-gray-200 border">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">ลำดับ</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">ชื่อร้าน</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">รหัสผู้ใช้</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">รหัสการโอน</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">สร้างเมื่อ</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">สถานะ</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-100">
      <% @stores.each do |store| %>
        <tr class="hover:bg-gray-50 transition cursor-pointer" 
            onclick="window.location='<%= admin_store_path(store) %>'">
          
          <td class="px-4 py-2 text-sm text-gray-800"><%= store.id %></td>
          <td class="px-4 py-2 text-sm text-gray-800"><%= store.name %></td>
          <td class="px-4 py-2 text-sm text-gray-800"><%= store.seller_user_id %></td>
          <td class="px-4 py-2 text-sm text-gray-800"><%= store.omise_recipient_id %></td>
          <td class="px-4 py-2 text-sm text-gray-800"><%= store.created_at.strftime("%d/%m/%Y %H:%M") %></td>

          <td class="px-4 py-2 text-sm text-gray-800" onclick="event.stopPropagation();">
            <%= form_with url: toggle_status_admin_store_path(store), method: :patch, class: "inline" do %>
              <label class="relative inline-flex items-center cursor-pointer">
                <%= check_box_tag :status, "1", store.active?, class: "sr-only peer", onchange: "this.form.requestSubmit();" %>
                <div class="w-12 h-6 bg-gray-300 rounded-full peer-checked:bg-green-500 transition-colors"></div>
                <div class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow-md transition-transform peer-checked:translate-x-6"></div>
              </label>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @stores.empty? %>
    <p class="text-gray-500 mt-4">ไม่มีร้านค้าในระบบ</p>
  <% end %>
</div>