<div class="mb-6 rounded-xl border border-blue-100 bg-blue-50/80 px-4 py-3 text-sm text-gray-700 max-w-2xl">
  <p class="font-semibold text-gray-900 mb-1">แคมเปญคืออะไร (ต่างจากโปรที่ตั้งในสินค้า)</p>
  <ul class="list-disc pl-5 space-y-1 text-gray-600">
    <li><strong>โปรที่หน้าสินค้า (ผู้ขาย)</strong> — กำหนดราคาเต็ม / ราคาโปร และถ้าต้องการให้ใช้เฉพาะช่วงเวลา ให้ใส่วันเริ่ม–สิ้นสุดโปรที่ฟอร์มสินค้า</li>
    <li><strong>แคมเปญ (แอดมิน)</strong> — ช่วงวันลดของทั้งแพลตฟอร์ม (เช่น 11.11) เลือกสินค้าเข้าร่วม และกำหนด % ลดจาก <em>ราคาหลังคำนวณโปรร้านแล้ว</em></li>
    <li>ถ้าไม่ใส่วันโปรที่สินค้า แต่ใส่ราคาโปรที่ถูกกว่าราคาเต็ม = ถือว่าลดได้ทันทีจนกว่าจะแก้ราคา</li>
  </ul>
</div>

<%= form_with model: [:admin, campaign], class: "space-y-4 max-w-2xl" do |f| %>
  <% if campaign.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <% campaign.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "ชื่อแคมเปญ", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :slug, "Slug (ว่างได้ — จะสร้างจากชื่อ)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :slug, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :starts_at, "เริ่ม", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.datetime_field :starts_at, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :ends_at, "สิ้นสุด", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.datetime_field :ends_at, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :discount_percent, "ส่วนลดจากราคาหลังโปรร้าน (%)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :discount_percent, min: 0, max: 100, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
    <p class="text-xs text-gray-500 mt-1">ใช้กับสินค้าที่เลือกด้านล่าง ในช่วงเวลาที่กำหนด (เช่น 11.11 = ลด 11% จากราคาที่คำนวณแล้ว)</p>
  </div>

  <div>
    <%= f.label :product_ids, "สินค้าในแคมเปญ (กด Ctrl/Cmd เลือกหลายรายการ)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%# ส่งค่าว่างได้เมื่อไม่เลือกสินค้า (เคลียร์รายการ) %>
    <%= hidden_field_tag "campaign[product_ids][]", "" %>
    <% product_opts = Product.unscoped.joins(:store).order("seller_stores.name ASC, products.title ASC") %>
    <%= f.collection_select :product_ids,
          product_opts,
          :id,
          :title_with_store,
          {},
          { multiple: true, size: 12, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-sans" } %>
  </div>

  <div class="flex gap-2 pt-2">
    <%= f.submit "บันทึก", class: "rounded-lg bg-blue-600 text-white px-5 py-2 text-sm font-medium hover:bg-blue-700" %>
    <%= link_to "ยกเลิก", admin_campaigns_path, class: "rounded-lg border border-gray-300 px-5 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
