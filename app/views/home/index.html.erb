<% if @marketplace_has_products %>
  <div class="w-full min-h-screen bg-white">
    <div class="w-full max-w-screen-xl mx-auto space-y-8 py-6">
      <% if @home_has_banners %>
        <%= render "home/partials/banner", banners: @banners %>
        <%= render "home/partials/skin_concern", skin_concerns: @skin_concerns %>
        <% if @flash_products.any? %>
          <%= render "home/partials/flash_sale_frame",
                      flash_products: @flash_products,
                      flash_countdown_end_unix: @flash_countdown_end_unix %>
        <% end %>
      <% else %>
        <% if @flash_products.any? %>
          <%= render "home/partials/flash_sale_frame",
                      flash_products: @flash_products,
                      flash_countdown_end_unix: @flash_countdown_end_unix %>
        <% end %>
        <%= render "home/partials/skin_concern", skin_concerns: @skin_concerns %>
      <% end %>
      <% if @bestsellers.any? %>
        <%= render "home/partials/bestseller", bestsellers: @bestsellers, tabs: @bestseller_tabs %>
      <% end %>
      <%= render "home/partials/all_products", products: @essential_products %>
    </div>
  </div>
<% else %>
  <div class="w-full min-h-screen bg-white flex flex-col items-center justify-center px-4 py-10">
    <%= render "home/partials/empty_marketplace" %>
  </div>
<% end %>

<% if @show_payment_success_modal %>
  <%= render "shared/payment_success_modal" %>
<% end %>
