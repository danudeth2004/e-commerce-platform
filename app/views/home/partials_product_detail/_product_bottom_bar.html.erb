<div data-controller="quantity" class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white shadow-pinkGlow border-t border-gray-100 px-4 py-6">
  <div class="grid grid-cols-2 gap-4 items-center">
    <!-- ฝั่งซ้าย (ปุ่มจำนวน) -->
    <div class="flex items-center justify-center">
      <div class="grid grid-cols-3 items-center gap-4">
        <button
          data-action="click->quantity#decrease"
          class="w-12 h-12 rounded-full bg-gray-300 flex items-center justify-center text-3xl text-white">
          −
        </button>
        <span
          data-quantity-target="count"
          class="text-3xl font-medium text-text-primary text-center">
          0
        </span>
        <button
          data-action="click->quantity#increase"
          class="w-12 h-12 rounded-full bg-Primary-color flex items-center justify-center text-3xl text-white">
          +
        </button>
      </div>
    </div>
    <!-- ปุ่มเพิ่มสินค้า -->
    <%= form_with url: add_item_cart_path, method: :post, local: true, class: "w-full" do |f| %>
      <%= hidden_field_tag :product_id, product.id %>
      <%= hidden_field_tag :quantity, 0, data: { quantity_target: "input" } %>
      <button
        data-quantity-target="submit"
        class="w-full bg-Primary-color text-white px-4 py-3 rounded-xl text-sm flex items-center justify-center opacity-50 cursor-not-allowed"
        disabled>
        เพิ่มสินค้าใส่ตะกร้า
      </button>
    <% end %>
  </div>
</div>
