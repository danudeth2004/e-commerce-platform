<% p = product_detail_price_parts(product) %>
<% price = p[:price] %>
<% original_price = p[:original] %>
<% discount_percent = p[:discount_percent] %>
<div class="relative bg-gradient-to-br from-pink-50 to-purple-50 px-8 py-6">
  <% if product.images.attached? %>
    <%= image_tag product.images.first, class: "w-full h-auto object-contain" %>
  <% else %>
    <%= image_tag "https://via.placeholder.com/300x300.png?text=#{ERB::Util.url_encode(product.title)}",
                  class: "w-full h-auto object-contain" %>
  <% end %>
  <div class="absolute top-4 right-4 bg-gray-300 text-gray-600 px-3 py-1 rounded-full text-xs">
    สินค้า
  </div>
</div>
<div class="px-4 py-3">
  <h1 class="text-base font-semibold leading-relaxed text-text-primary">
    <%= product.title %>
  </h1>
  <% if product.description.present? %>
    <p class="text-xs text-gray-500 mt-1 line-clamp-2">
      <%= product.description %>
    </p>
  <% end %>
  <div class="flex items-start justify-between gap-2 mt-2">
    <div class="flex flex-wrap items-center gap-3 min-w-0">
      <span class="text-red-500 text-xl font-semibold">
        ฿ <%= number_with_delimiter(price) %>
      </span>
      <% if original_price.present? %>
        <span class="text-gray-400 text-base line-through">
          ฿ <%= number_with_delimiter(original_price) %>
        </span>
      <% end %>
      <% if discount_percent.present? %>
        <span class="text-red-500 text-base">
          -<%= discount_percent %>%
        </span>
      <% end %>
    </div>
    <% if seller_owns_product?(product) %>
      <details class="relative shrink-0 z-20 group">
        <summary class="list-none cursor-pointer flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 text-lg leading-none [&::-webkit-details-marker]:hidden">
          ⋯
        </summary>
        <div class="absolute right-0 top-full mt-1 min-w-[11rem] rounded-xl bg-white py-1 shadow-lg border border-gray-100">
          <%= link_to "แก้ไขสินค้า", edit_seller_product_path(product), class: "block px-4 py-2.5 text-sm text-gray-800 hover:bg-gray-50" %>
          <%= link_to "ลบสินค้า", seller_product_path(product),
                      data: { turbo_method: :delete, turbo_confirm: "ลบสินค้านี้จากร้านของคุณ?" },
                      class: "block px-4 py-2.5 text-sm text-red-600 hover:bg-red-50" %>
        </div>
      </details>
    <% end %>
  </div>
</div>
