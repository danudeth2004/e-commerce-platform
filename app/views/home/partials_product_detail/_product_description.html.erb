<div class="px-4 py-4">
  <h2 class="text-xl font-semibold mb-3 text-text-primary">รายละเอียดสินค้า</h2>
  <% if product.skin_concern_labels.any? %>
    <div class="flex flex-wrap gap-2 mb-4">
      <% product.skin_concern_labels.each do |label| %>
        <span class="inline-flex rounded-full bg-pink-100 px-3 py-1 text-xs font-medium text-pink-900">
          <%= label %>
        </span>
      <% end %>
    </div>
  <% end %>
  <% category_label = ProductCategory.label_for(product.category_key) %>
  <% if product.standard? && (category_label.present? || product.volume.present?) %>
    <dl class="mb-4 grid gap-2 text-sm text-gray-800">
      <% if category_label.present? %>
        <div class="flex gap-2">
          <dt class="shrink-0 text-gray-500">ประเภท</dt>
          <dd class="font-medium"><%= category_label %></dd>
        </div>
      <% end %>
      <% if product.volume.present? %>
        <div class="flex gap-2">
          <dt class="shrink-0 text-gray-500">ปริมาณ</dt>
          <dd class="font-medium"><%= number_with_delimiter(product.volume) %> <%= product.volume_unit %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>
  <% if product.bundle? %>
    <% bundle_type_label = Product::BUNDLE_SET_TYPE_OPTIONS.find { |_, k| k == product.bundle_set_type_key }&.first %>
    <% if bundle_type_label.present? %>
      <p class="mb-3 text-sm text-gray-700">
        <span class="text-gray-500">ประเภทเซต</span>
        <span class="ml-1 font-medium text-text-primary"><%= bundle_type_label %></span>
      </p>
    <% end %>
  <% end %>
  <% if product.effect.present? %>
    <div class="mb-4 rounded-xl border border-gray-100 bg-gray-50/80 px-4 py-3">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1">ผลลัพธ์</p>
      <p class="text-sm text-gray-800 leading-relaxed"><%= product.effect %></p>
    </div>
  <% end %>
  <% if product.bundle? && product.bundle_items.any? %>
    <div class="mb-6 rounded-2xl border border-pink-100 bg-pink-50/50 px-4 py-3">
      <p class="text-sm font-semibold text-text-primary mb-2">สินค้าในเซตนี้</p>
      <ol class="space-y-3 list-decimal list-inside text-sm text-gray-800">
        <% product.bundle_items.each do |item| %>
          <% comp = item.component_product %>
          <% h = product_to_card_hash(comp) %>
          <li class="marker:font-semibold">
            <span class="font-medium"><%= comp.title %></span>
            <span class="text-gray-500"> — ฿ <%= number_with_delimiter(h[:price]) %></span>
            <% if item.usage_instructions.present? %>
              <p class="mt-1 text-xs text-gray-600 pl-0 list-none">วิธีใช้: <%= item.usage_instructions %></p>
            <% end %>
          </li>
        <% end %>
      </ol>
    </div>
  <% end %>
  <% if product.description.present? %>
    <p class="text-base leading-relaxed text-gray-700">
      <%= product.description %>
    </p>
  <% else %>
    <p class="text-base leading-relaxed text-gray-400">
      ยังไม่มีรายละเอียดสินค้าสำหรับรายการนี้
    </p>
  <% end %>
  <% if product.usage.present? %>
    <div class="mt-6 pt-4 border-t border-gray-100">
      <h3 class="text-sm font-semibold text-text-primary mb-2">วิธีใช้</h3>
      <p class="text-base leading-relaxed text-gray-700 whitespace-pre-line"><%= product.usage %></p>
    </div>
  <% end %>
</div>
<br>
