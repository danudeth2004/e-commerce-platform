<section class="px-4 pt-5" data-controller="bestseller">
  <div class="text-xl font-semibold text-text-primary mb-3">สินค้าขายดีติดอันดับ</div>
  <div class="flex flex-col">
    <% bestsellers.each_with_index do |item, i| %>
      <%= link_to product_path(item[:id]),
            class: "flex items-center gap-3 py-4 cursor-pointer no-underline text-inherit #{i.odd? ? 'bg-Tertiary-color bg-opacity-20' : 'bg-white'}",
            aria: { label: "ดูรายละเอียด #{item[:brand]}" } do %>
        <% if i == 0 %>
          <div class="flex-1 flex flex-col items-center text-center">
            <div class="text-2xl font-black text-gray-800 mb-1">01</div>
            <div class="text-base font-bold text-gray-800 mb-1"><%= item[:brand] %></div>
            <div class="text-xs text-gray-400 leading-relaxed mb-2 line-clamp-2"><%= item[:desc] %></div>
            <div class="font-prompt text-base font-bold" style="color:#FF6B9D">
              ฿ <%= number_with_delimiter(item[:price]) %>
            </div>
          </div>
          <div class="w-24 h-24 rounded-xl overflow-hidden shrink-0 bg-gray-50">
            <% if item[:image_url].present? %>
              <%= image_tag item[:image_url], class: "w-full h-full object-contain", alt: item[:brand] %>
            <% else %>
              <div class="w-full h-full" style="background-image:linear-gradient(45deg,#e5e7eb 25%,transparent 25%),linear-gradient(-45deg,#e5e7eb 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e5e7eb 75%),linear-gradient(-45deg,transparent 75%,#e5e7eb 75%);background-size:12px 12px;background-position:0 0,0 6px,6px -6px,-6px 0;background-color:#f9fafb;"></div>
            <% end %>
          </div>
        <% else %>
          <span class="font-prompt text-2xl font-black min-w-[44px] text-center leading-none text-gray-300">
            <%= sprintf('%02d', i + 1) %>
          </span>
          <div class="w-14 h-14 rounded-xl overflow-hidden shrink-0 bg-gray-50">
            <% if item[:image_url].present? %>
              <%= image_tag item[:image_url], class: "w-full h-full object-contain", alt: item[:brand] %>
            <% else %>
              <div class="w-full h-full" style="background-image:linear-gradient(45deg,#e5e7eb 25%,transparent 25%),linear-gradient(-45deg,#e5e7eb 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e5e7eb 75%),linear-gradient(-45deg,transparent 75%,#e5e7eb 75%);background-size:12px 12px;background-position:0 0,0 6px,6px -6px,-6px 0;background-color:#f9fafb;"></div>
            <% end %>
          </div>
          <div class="flex-1">
            <div class="text-sm font-bold text-gray-800"><%= item[:brand] %></div>
            <div class="text-xs text-gray-400 leading-relaxed mt-0.5 line-clamp-2"><%= item[:desc] %></div>
            <div class="font-prompt text-sm font-bold mt-1" style="color:#FF6B9D">
              ฿ <%= number_with_delimiter(item[:price]) %>
              <% if item[:original_price] %>
                <span class="text-xs text-gray-300 line-through font-normal ml-1">฿ <%= number_with_delimiter(item[:original_price]) %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
