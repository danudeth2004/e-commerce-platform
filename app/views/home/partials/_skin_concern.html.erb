<section class="px-4">
  <h2 class="text-xl font-semibold text-text-primary mb-4">เลือกตามปัญหาผิว</h2>
  <div class="grid grid-cols-4 md:grid-cols-8 gap-3">
    <% skin_concerns.each do |concern| %>
      <div class="flex flex-col items-center gap-2 cursor-pointer">
        <div class="w-full aspect-square rounded-2xl overflow-hidden border-2 border-transparent transition-all duration-200 shadow-pinkGlow hover:scale-105 hover:border-pink-300 hover:shadow-md">
          <% if concern[:image_url].present? %>
            <%= image_tag concern[:image_url], class: "w-full h-full object-cover", alt: concern[:label], loading: "lazy" %>
          <% else %>
            <div class="w-full h-full" 
            style="background-image:  linear-gradient(45deg, #e5e7eb 25%, transparent 25%),
                                      linear-gradient(-45deg, #e5e7eb 25%, transparent 25%),
                                      linear-gradient(45deg, transparent 75%, #e5e7eb 75%),
                                      linear-gradient(-45deg, transparent 75%, #e5e7eb 75%);
                                      background-size: 14px 14px;
                                      background-position: 0 0, 0 7px, 7px -7px, -7px 0;
                                      background-color: #f9fafb;">
            </div>
          <% end %>
        </div>
        <span class="text-sm text-text-primary text-center leading-tight">
          <%= concern[:label] %>
        </span>
      </div>
    <% end %>
  </div>
</section>
