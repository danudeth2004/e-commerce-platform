<section class="rounded-l-2xl">
  <div class="rounded-l-2xl p-4 bg-Secondary-color bg-opacity-20">
    <h2 class="text-xl font-semibold text-text-primary text-center mb-3">สินค้าราคาพิเศษสำหรับวันนี้</h2>
    <div class="flex items-center justify-center gap-2 mb-4" data-controller="countdown" data-countdown-end-value="<%= (Time.now.end_of_day).to_i %>">
      <div class="bg-gray-600 text-white p-2 rounded-xl min-w-[44px] text-center" data-countdown-target="hours">24</div>
      <span class="text-gray-600 font-bold text-lg">:</span>
      <div class="bg-gray-600 text-white p-2 rounded-xl min-w-[44px] text-center" data-countdown-target="minutes">59</div>
      <span class="text-gray-600 font-bold text-lg">:</span>
      <div class="bg-gray-600 text-white p-2 rounded-xl min-w-[44px] text-center" data-countdown-target="seconds">59</div>
    </div>
    <div class="flex gap-3 overflow-x-auto pb-1" style="-ms-overflow-style:none; scrollbar-width:none;">
      <% flash_products.each do |product| %>
        <%= render "shared/product_card", product: product %>
      <% end %>
    </div>
  </div>
</section>
