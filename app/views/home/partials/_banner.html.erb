<% first = banners.first %>
<section class="px-4 pt-4" data-controller="banner" data-banner-index-value="0">
  <div
    id="bannerCard"
    class="rounded-3xl overflow-hidden min-h-[140px] flex items-center justify-center bg-gray-100 cursor-pointer transition-all duration-500">
    <%= image_tag first[:image_url],
                  id: "bannerImage",
                  alt: "",
                  class: "w-full h-auto object-cover object-center" %>
  </div>
  <% if banners.size > 1 %>
    <div class="flex justify-center gap-1.5 mt-3" data-banner-target="dots">
      <% banners.each_with_index do |_, i| %>
        <button type="button"
                class="dot h-1.5 rounded-full transition-all duration-300 cursor-pointer <%= i == 0 ? 'w-4' : 'w-1.5 bg-pink-200' %>"
                style="<%= i == 0 ? 'background:#FF6B9D' : '' %>"
                data-action="click->banner#go"
                data-index="<%= i %>"
                aria-label="สไลด์ <%= i + 1 %>"></button>
      <% end %>
    </div>
  <% end %>
  <script nonce="<%= request.content_security_policy_nonce %>">
    window.BANNERS = <%= raw banners.to_json %>;
  </script>
</section>
