<% total_cents = total_cents.to_i %>

<div class="fixed bottom-0 left-0 right-0 z-10 border-t border-gray-100 bg-white px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3">
  <div class="mx-auto w-full max-w-md">
    <%= button_to create_order_checkout_path,
                  method: :post,
                  class: "flex w-full items-center justify-between rounded-full border-0 bg-[#FF1493] px-6 py-3.5 text-left text-sm font-semibold text-white shadow-sm hover:opacity-95 active:scale-[0.99]" do %>
      <span>ชำระเงิน</span>
      <span class="tabular-nums">฿ <%= number_with_delimiter(total_cents / 100) %></span>
    <% end %>
  </div>
</div>
