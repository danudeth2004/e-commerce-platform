<% product = item.product %>
<% promo_map = local_assigns.fetch(:promo_flag_by_product_id) %>
<% promo = promo_map[product.id] %>
<% line_cents = product.amount_cents * item.quantity %>
<% unit_baht = product.amount_cents / 100 %>
<% orig_baht = promo ? promo.original_amount_cents / 100 : nil %>
<% discount_pct =
     if promo && promo.original_amount_cents.to_i.positive?
       (((promo.original_amount_cents - product.amount_cents).to_f / promo.original_amount_cents) * 100).round
     end %>

<div class="rounded-2xl border border-gray-100 bg-white p-3 shadow-[0_1px_8px_rgba(0,0,0,0.06)]">
  <div class="flex gap-3">
    <div class="h-[4.5rem] w-[4.5rem] shrink-0 overflow-hidden rounded-xl bg-gray-50">
      <% if product.images.attached? %>
        <%= image_tag product.images.first, class: "h-full w-full object-cover", alt: "" %>
      <% else %>
        <div class="h-full w-full bg-gray-100"></div>
      <% end %>
    </div>

    <div class="min-w-0 flex-1">
      <p class="line-clamp-3 text-left text-xs font-medium leading-snug text-gray-900">
        <%= product.title %>
      </p>

      <div class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
        <span class="text-sm font-bold text-[#FF1493]">฿ <%= number_with_delimiter(line_cents / 100) %></span>
        <% if orig_baht.present? && orig_baht > unit_baht %>
          <span class="text-xs text-gray-400 line-through">฿ <%= number_with_delimiter(orig_baht * item.quantity) %></span>
          <% if discount_pct.present? && discount_pct.positive? %>
            <span class="text-xs font-semibold text-[#FF1493]">-<%= discount_pct %>%</span>
          <% end %>
        <% end %>
      </div>

      <div class="mt-3 flex items-center gap-3">
        <%= button_to decrease_item_cart_path(id: item.id),
                      method: :patch,
                      class: "flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-[#D1D5DB] p-0 text-lg font-medium leading-none text-gray-700 shadow-sm hover:bg-gray-300",
                      form: { class: "m-0 inline-flex p-0" } do %>
          −
        <% end %>
        <span class="min-w-[1.25rem] text-center text-sm font-semibold text-gray-900"><%= item.quantity %></span>
        <%= button_to increase_item_cart_path(id: item.id),
                      method: :patch,
                      class: "flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-[#FF1493] p-0 text-lg font-medium leading-none text-white shadow-sm hover:opacity-95",
                      form: { class: "m-0 inline-flex p-0" } do %>
          +
        <% end %>
      </div>
    </div>
  </div>
</div>
