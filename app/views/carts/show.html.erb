<div class="w-full min-h-screen bg-white">
  <div class="w-full max-w-screen-md mx-auto px-4 pt-4 pb-28 space-y-4">
    <h1 class="text-xl font-semibold text-text-primary mb-4">
      รถเข็นของคุณ (<%= @cart_items.sum(:quantity) %>)
    </h1>

    <% if @cart_items.any? %>
      <div class="space-y-3">
        <% @cart_items.each do |item| %>
          <%= render "carts/item", item: item %>
        <% end %>
      </div>

      <% total_cents = @cart_items.sum { |i| i.product.amount_cents * i.quantity } %>
      <%= render "carts/summary_bar", total_cents: total_cents %>
    <% else %>
      <%= render "carts/empty" %>
    <% end %>
  </div>
</div>
