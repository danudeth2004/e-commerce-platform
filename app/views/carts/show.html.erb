<div class="flex min-h-screen w-full max-w-md mx-auto flex-col bg-white">
  <div class="shrink-0 px-4 pb-2 pt-10">
    <h1 class="text-center text-base font-bold text-gray-900">
      รถเข็นของคุณ<% if @cart_qty_total.positive? %> (<%= @cart_qty_total %>)<% end %>
    </h1>
  </div>
  <div class="flex flex-1 flex-col px-4 <%= @cart_items.any? ? "pb-48" : "pb-10" %>">
    <% if @cart_items.any? %>
      <div class="flex flex-col gap-3">
        <% @cart_items.each do |item| %>
          <%= render "carts/item", item: item, promo_flag_by_product_id: @promo_flag_by_product_id %>
        <% end %>
      </div>
    <% else %>
      <%= render "carts/empty" %>
    <% end %>
  </div>
  <% if @cart_items.any? %>
    <% total_cents = @cart_items.sum { |i| i.product.final_price_cents * i.quantity } %>
    <%= render "carts/summary_bar", total_cents: total_cents %>
  <% end %>
</div>
