<%# การ์ดเซตสินค้า (คนละแบบกับ product_card)
    Params: product (hash), show_cart, full_width, link_to_path, theme: :default | :neutral
%>
<% show_cart = local_assigns.fetch(:show_cart, true) %>
<% full_width = local_assigns.fetch(:full_width, false) %>
<% link_to_path = local_assigns.fetch(:link_to_path, product_path(product[:id])) %>
<% neutral = local_assigns.fetch(:theme, :default) == :neutral %>
<% checkerboard_style = "background-image:linear-gradient(45deg,#e5e7eb 25%,transparent 25%),linear-gradient(-45deg,#e5e7eb 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e5e7eb 75%),linear-gradient(-45deg,transparent 75%,#e5e7eb 75%);background-size:14px 14px;background-position:0 0,0 7px,7px -7px,-7px 0;background-color:#f9fafb;" %>
<% card_class = if neutral
     [ full_width ? "w-full" : "shrink-0 w-40",
       "bg-white rounded-2xl overflow-hidden cursor-pointer hover:-translate-y-0.5 hover:shadow-md transition-all duration-200 border border-gray-200" ].join(" ")
   else
     [ full_width ? "w-full" : "shrink-0 w-40",
       "bg-white rounded-2xl overflow-hidden cursor-pointer hover:-translate-y-1 hover:shadow-lg transition-all duration-200 border border-pink-100/60" ].join(" ")
   end %>
<% card_style = neutral ? "box-shadow: 0 1px 3px 0 rgba(0,0,0,0.06), 0 2px 8px 0 rgba(0,0,0,0.04)" : "box-shadow: 0 1px 4px 0 rgba(255,105,180,0.08), 0 4px 12px 0 rgba(0,0,0,0.06)" %>
<% link_data = { turbo_frame: "_top" } %>
<% link_data.merge!(controller: "product-card", product_id: product[:id]) if show_cart %>
<% thumbs = product[:bundle_thumb_urls] || [] %>
<% overflow = product[:bundle_overflow_count].to_i %>
<% bcount = product[:bundle_item_count].to_i %>

<%= link_to link_to_path, class: card_class, style: card_style, data: link_data do %>
  <div class="relative w-full <%= neutral ? "bg-gray-50/80 px-2 pt-2 pb-1" : "bg-gradient-to-b from-pink-50/80 to-gray-50 px-2 pt-2 pb-1" %>">
    <% if product[:discount_percent].to_i > 0 %>
      <div class="absolute top-2 left-2 z-10 rounded-md bg-red-500 px-1.5 py-0.5 text-[10px] font-bold text-white shadow-sm ring-2 ring-white/90">
        -<%= product[:discount_percent] %>%
      </div>
    <% end %>
    <div class="flex gap-1.5">
      <% thumbs.each do |url| %>
        <div class="flex-1 aspect-square rounded-lg overflow-hidden bg-gray-100 min-h-0 max-h-28 <%= neutral ? "ring-1 ring-gray-200/80" : "ring-1 ring-pink-100" %>">
          <% if url.present? %>
            <%= image_tag url, class: "w-full h-full object-cover", alt: "", loading: "lazy" %>
          <% else %>
            <div class="w-full h-full" style="<%= checkerboard_style %>"></div>
          <% end %>
        </div>
      <% end %>
      <% if overflow > 0 %>
        <div class="flex-1 aspect-square max-h-28 rounded-lg flex items-center justify-center text-sm font-bold <%= neutral ? "bg-gray-200/90 text-gray-700 ring-1 ring-gray-300" : "bg-pink-100/90 text-pink-700 ring-1 ring-pink-200" %>">
          +<%= overflow %>
        </div>
      <% end %>
    </div>
    <p class="text-left text-[10px] mt-1 pr-0.5 font-medium <%= neutral ? "text-gray-500" : "text-pink-900/50" %>">สินค้าทั้งหมด <%= bcount %> ตัว</p>
    <% if show_cart %>
      <button
        type="button"
        class="absolute bottom-2 right-2 w-8 h-8 rounded-full flex items-center justify-center shadow-md hover:scale-110 transition-transform z-10"
        style="background:#D1D5DB"
        data-action="click->product-card#addToCart"
        data-product-card-target="addBtn">
        <%= inline_svg_tag "icons/shopping-cart-icon.svg", class: "w-4 h-4 text-white fill-current" %>
      </button>
    <% end %>
  </div>
  <div class="px-3 pt-2 pb-3">
    <div class="mb-1 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide <%= neutral ? "bg-gray-100 text-gray-700" : "bg-pink-100 text-pink-800" %>">
      <span class="iconify <%= neutral ? "text-gray-500" : "text-pink-600" %>" data-icon="lucide:package" data-width="10"></span>
      เซตสินค้า
    </div>
    <div class="flex items-baseline gap-2 mb-0.5 mt-1">
      <% if neutral %>
        <span class="font-prompt text-sm font-bold text-gray-900">
          ฿ <%= number_with_delimiter(product[:price]) %>
        </span>
      <% else %>
        <span class="font-prompt text-sm font-bold" style="color:#FF6B9D">
          ฿ <%= number_with_delimiter(product[:price]) %>
        </span>
      <% end %>
      <% if product[:original_price] %>
        <span class="text-xs text-gray-400 line-through">฿ <%= number_with_delimiter(product[:original_price]) %></span>
      <% end %>
    </div>
    <div class="text-sm font-bold text-gray-800 line-clamp-2"><%= product[:name] %></div>
    <% if product[:skin_concern_labels].present? %>
      <div class="mt-2 overflow-x-auto no-scrollbar">
        <div class="flex gap-2">
          <% product[:skin_concern_labels].each do |label| %>
            <span class="inline-flex items-center whitespace-nowrap rounded-full bg-pink-100 px-3 py-1 text-xs font-medium text-pink-900">
              <%= label %>
            </span>
          <% end %>
          <% if product[:skin_concern_labels_count].to_i > 0 %>
            <span class="inline-flex items-center whitespace-nowrap rounded-full bg-pink-100 px-3 py-1 text-xs font-medium text-pink-900">
              +<%= product[:skin_concern_labels_count] %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
