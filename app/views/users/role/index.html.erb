<div class="min-h-screen bg-white flex items-start justify-center pt-10 px-4">
  <div class="w-full max-w-md">

    <h1 class="text-xl font-semibold text-gray-800 mb-6">
      เลือกประเภทบัญชีที่คุณต้องการเข้าสู่ระบบ
    </h1>

    <%= link_to new_user_session_path,
      class: "flex items-center gap-4 bg-white rounded-2xl p-4 mb-4
              shadow-md hover:shadow-lg transition" do %>

      <%= inline_svg_tag "icons/user-login-select.svg", class: "w-[40px] h-[40px]" %>

      <div>
        <p class="text-base font-semibold text-gray-800">
          เข้าสู่ระบบบัญชีผู้ใช้งาน
        </p>
        <p class="text-sm text-gray-400">
          เข้าสู่ระบบสำหรับซื้อของกับเรา
        </p>
      </div>

    <% end %>

    <%= link_to new_seller_user_session_path,
      class: "flex items-center gap-4 bg-white rounded-2xl p-4
              shadow-md hover:shadow-lg transition" do %>

      <%= inline_svg_tag "icons/seller-login-select.svg", class: "w-[40px] h-[40px]" %>

      <div>
        <p class="text-base font-semibold text-gray-800">
          เข้าสู่ระบบบัญชีร้านค้า
        </p>
        <p class="text-sm text-gray-400">
          เข้าสู่ระบบสำหรับเริ่มการขายของกับเรา
        </p>
      </div>

    <% end %>
  </div>
</div>
