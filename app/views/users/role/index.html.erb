<div class="min-h-screen bg-white flex items-start justify-center pt-10 px-4">
  <div class="w-full max-w-md">

    <h1 class="text-xl font-semibold text-gray-800 mb-6">
      เลือกประเภทบัญชีที่คุณต้องการสร้าง
    </h1>

    <%= link_to new_user_registration_path,
      class: "flex items-center gap-4 bg-white rounded-2xl p-4 mb-4
              shadow-md hover:shadow-lg transition" do %>

      <div class="w-12 h-12 flex items-center justify-center
                  bg-pink-100 text-pink-500 rounded-full text-xl">
        👤
      </div>

      <div>
        <p class="text-base font-semibold text-gray-800">
          สร้างบัญชีผู้ใช้งาน
        </p>
        <p class="text-sm text-gray-400">
          สร้างบัญชีสำหรับซื้อของกับเรา
        </p>
      </div>

    <% end %>

    <%= link_to new_seller_user_registration_path,
      class: "flex items-center gap-4 bg-white rounded-2xl p-4
              shadow-md hover:shadow-lg transition" do %>

      <div class="w-12 h-12 flex items-center justify-center
                  bg-pink-100 text-pink-500 rounded-full text-xl">
        🏪
      </div>

      <div>
        <p class="text-base font-semibold text-gray-800">
          สร้างบัญชีร้านค้า
        </p>
        <p class="text-sm text-gray-400">
          สร้างบัญชีสำหรับเริ่มการขายของกับเรา
        </p>
      </div>

    <% end %>
  </div>
</div>
