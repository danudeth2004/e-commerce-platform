<div class="min-h-screen bg-gradient-to-b from-rose-50/70 via-white to-slate-50/90 py-8 px-4">
  <div class="w-full max-w-md mx-auto rounded-2xl border border-rose-100/80 bg-white/90 p-6 shadow-lg shadow-rose-100/30 ring-1 ring-rose-50/50 sm:p-8">
    <div class="mb-6">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-1">
            สร้างบัญชีของคุณ
        </h2>
        <p class="text-sm text-slate-500">
            กรอกรายละเอียดเพื่อเริ่มซื้อของกับเราได้เลย
        </p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>


      <div class="grid grid-cols-2 gap-3 mb-4">

        <div>
          <%= f.label :first_name, "ชื่อ ",
            class: "block text-base font-regular text-text-primary mb-2" do %>
            ชื่อ <span class="text-red-500">*</span>
          <% end %>

          <%= f.text_field :first_name,
            required: true,
            placeholder: "กรอกชื่อ",
            class: "w-full px-3 py-2.5 text-sm text-text-primary bg-white border border-border-neutral rounded-lg placeholder:text-text-placeholder focus:border-Primary-color focus:outline-none" %>
        </div>

        <div>
          <%= f.label :last_name, "นามสกุล ",
            class: "block text-base font-regular text-text-primary mb-2" do %>
            นามสกุล <span class="text-red-500">*</span>
          <% end %>

          <%= f.text_field :last_name,
            required: true,
            placeholder: "กรอกนามสกุล",
            class: "w-full px-3 py-2.5 text-sm text-text-primary bg-white border border-border-neutral rounded-lg placeholder:text-text-placeholder focus:border-Primary-color focus:outline-none" %>
        </div>

      </div>

      <div class="mb-4">
        <%= f.label :location, "ที่อยู่",
          class: "block text-base font-regular text-text-primary mb-2" %>

        <%= f.text_field :location,
          placeholder: "กรอกที่อยู่จัดส่งของคุณ",
          class: "w-full px-3 py-2.5 text-sm text-text-primary bg-white border border-border-neutral rounded-lg placeholder:text-text-placeholder focus:border-Primary-color focus:outline-none" %>
      </div>

      <div class="mb-4">
        <%= f.label :phone_number, "เบอร์โทรศัพท์",
          class: "block text-base font-regular text-text-primary mb-2" do %>
          เบอร์โทรศัพท์ <span class="text-red-500">*</span>
          <% end %>

        <%= f.text_field :phone_number,
          required: true,
           placeholder: "กรอกเบอร์โทรศัพท์ของคุณ",
          class: "w-full px-3 py-2.5 text-sm text-text-primary bg-white border border-border-neutral rounded-lg placeholder:text-text-placeholder focus:border-Primary-color focus:outline-none" %>
      </div>

      <div class="mb-4">
        <%= f.label :email, "ที่อยู่อีเมล",
          class: "block text-base font-regular text-text-primary mb-2" do %>
          ที่อยู่อีเมล <span class="text-red-500">*</span>
          <% end %>

        <%= f.email_field :email,
          autocomplete: "email",
          required: true,
          placeholder: "example@domain.com",
          class: "w-full px-3 py-2.5 text-sm text-text-primary bg-white border border-border-neutral rounded-lg placeholder:text-text-placeholder focus:border-Primary-color focus:outline-none" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "รหัสผ่าน",
          class: "block text-base font-regular text-text-primary mb-2" do %>
          รหัสผ่าน <span class="text-red-500">*</span>
        <% end %>

        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mb-2">
            อย่างน้อย <%= @minimum_password_length %> ตัวอักษร
          </p>
        <% end %>

        <%= f.password_field :password,
          required: true,
          autocomplete: "new-password",
          placeholder: "กรอกรหัสผ่าน",
          class: "w-full px-3 py-2.5 text-sm text-text-primary bg-white border border-border-neutral rounded-lg placeholder:text-text-placeholder focus:border-Primary-color focus:outline-none" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, "ยืนยันรหัสผ่าน",
          class: "block text-base font-regular text-text-primary mb-2" do %>
          ยืนยันรหัสผ่าน <span class="text-red-500">*</span>
          <% end %>

        <%= f.password_field :password_confirmation,
          required: true,
          autocomplete: "new-password",
          placeholder: "ยืนยันรหัสผ่าน",
          class: "w-full px-3 py-2.5 text-sm text-text-primary bg-white border border-border-neutral rounded-lg placeholder:text-text-placeholder focus:border-Primary-color focus:outline-none" %>
      </div>

      <div class="mt-6">
        <%= f.submit "สร้างบัญชี",
          class: "w-full py-3.5 text-white text-base font-medium
                  rounded-full
                  bg-gradient-to-r from-pink-500 to-pink-600
                  shadow-lg shadow-pink-200
                  hover:opacity-90 active:scale-95
                  transition duration-200" %>
      </div>

    <% end %>

    <div class="flex flex-col gap-2 mt-6 text-center text-sm text-slate-500">
      <div class="mb-4">
        มีบัญชีอยู่แล้ว?
        <%= link_to "เข้าสู่ระบบ", new_session_path(resource_name),
          class: "font-semibold text-rose-600 hover:text-rose-700 transition" %>
      </div>

      <p>
        ต้องการสร้างบัญชีประเภทอื่น?
        <%= link_to "เลือกประเภท", users_role_path,
          class: "font-semibold text-rose-600 hover:text-rose-700 transition" %>
      </p>

    </div>

  </div>
</div>
