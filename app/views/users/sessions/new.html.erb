<div class="w-full max-w-md mx-auto">
  <div class=" gap-3 mb-4">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold text-text-primary mb-1">
        เข้าสู่ระบบ
      </h2>
      <p class="text-sm text-text-neutral-300 font-light">
        กรอกรายละเอียดเพื่อเข้าสู่ระบบและเริ่มใช้งาน
      </p>
    </div>
    <% if flash.any? %>
        <%= render "layouts/flash_messages" %>
    <% end %>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }) do |f| %>
      <div class="mb-4">
        <%= f.label :email, "ที่อยู่อีเมล",
            class: "block text-base font-regular text-text-primary mb-2" do %>
          ที่อยู่อีเมล <span class="text-red-500">*</span>
        <% end %>
        <div class="relative">
          <span class="absolute inset-y-0 left-3 flex items-center text-gray-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6"
                viewBox="0 0 24 24">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m2 7 10 7 10-7"/>
            </svg>
          </span>
          <%= f.email_field :email,
            placeholder: "example@domain.com",
            autofocus: true,
            autocomplete: "email",
            class: "w-full pl-10 pr-3 py-2.5 text-sm text-text-primary
                    bg-white border border-border-neutral rounded-lg
                    placeholder:text-text-placeholder
                    focus:border-Primary-color focus:outline-none" %>
        </div>
      </div>
      <div class="mb-6">
        <%= f.label :password, "รหัสผ่าน",
    class: "block text-base font-regular text-text-primary mb-2" do %>
          รหัสผ่าน <span class="text-red-500">*</span>
        <% end %>
        <div class="relative">
          <span class="absolute inset-y-0 left-3 flex items-center text-gray-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6"
        viewBox="0 0 24 24">
              <rect x="3" y="11" width="18" height="11" rx="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </span>
          <%= f.password_field :password,
      placeholder: "กรอกรหัสผ่าน",
      autocomplete: "current-password",
      class: "w-full pl-10 pr-3 py-2.5 text-sm text-text-primary
              bg-white border border-border-neutral rounded-lg
              placeholder:text-text-placeholder
              focus:border-Primary-color focus:outline-none" %>
        </div>
      </div>
      <div class="mt-6">
        <%= f.submit "เข้าสู่ระบบ", 
    class: "w-full py-3.5 text-white text-base font-medium rounded-full bg-gradient-to-r from-pink-500 to-pink-600 shadow-lg shadow-pink-200 hover:opacity-90 active:scale-95 transition duration-200" %> </div>
    <% end %>
    <div class="mt-6 text-center text-sm text-gray-400 font-light">
      ยังไม่มีบัญชีผู้ใช้ ?
      <%= link_to "สร้างบัญชี", new_registration_path(resource_name),
        class: "text-pink-500 font-medium hover:underline" %>
    </div>
  </div>
</div>
