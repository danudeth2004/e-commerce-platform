<div class="flex flex-col items-center text-center">
  <div class="size-24 shrink-0 overflow-hidden rounded-full border-4 border-white bg-gradient-to-br from-rose-100 to-pink-50 shadow-lg shadow-rose-200/50 ring-2 ring-rose-100/80">
    <% if user.avatar.attached? %>
      <%= image_tag user.avatar, class: "size-full object-cover", alt: "" %>
    <% else %>
      <div class="size-full bg-[repeating-conic-gradient(#fce7f3_0%_25%,#fdf2f8_0%_50%)] bg-[length:12px_12px]"></div>
    <% end %>
  </div>
  <p class="mt-4 text-lg font-bold tracking-tight text-slate-900">
    <%= [user.first_name, user.last_name].compact_blank.join(" ") %>
  </p>
  <p class="mt-1 text-sm text-slate-500"><%= user.email %></p>
</div>
