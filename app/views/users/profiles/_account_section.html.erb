<section class="mt-8">
  <h2 class="text-base font-semibold text-slate-900">บัญชีของฉัน</h2>
  <p class="mt-1 text-xs text-slate-400">แก้ไขได้จากเมนู ⋯ มุมขวาบน</p>
  <div class="mt-3 rounded-2xl border border-rose-100/80 bg-white/90 p-4 shadow-md shadow-rose-100/20 ring-1 ring-rose-50/40">
    <dl class="space-y-3 text-sm">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">ชื่อ</dt>
        <dd class="mt-0.5 font-medium text-slate-900"><%= [user.first_name, user.last_name].compact_blank.join(" ") %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">เบอร์โทร</dt>
        <dd class="mt-0.5 text-slate-800"><%= masked_thai_mobile(user.phone_number) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">ที่อยู่จัดส่ง</dt>
        <dd class="mt-0.5 leading-relaxed text-slate-700">
          <% default_addr = user.default_shipping_address %>
          <% if default_addr.present? %>
            <%= default_addr.full_address_lines.join(" ") %>
          <% else %>
            —
          <% end %>
        </dd>
      </div>
    </dl>
    <div class="mt-4 border-t border-rose-50 pt-3">
      <%= link_to "จัดการที่อยู่จัดส่ง", users_shipping_addresses_path,
            class: "text-sm font-medium text-Primary-color hover:underline" %>
    </div>
  </div>
</section>
