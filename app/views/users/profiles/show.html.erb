<div class="min-h-screen bg-white max-w-md mx-auto pb-12">
  <header class="sticky top-0 z-30 flex items-center justify-between gap-2 border-b border-gray-100 bg-white px-4 py-3">
    <%= link_to root_path, class: "inline-flex size-10 items-center justify-center rounded-full text-gray-700 hover:bg-gray-100", aria: { label: "กลับ" } do %>
      <span class="iconify text-2xl" data-icon="lucide:chevron-left" data-width="24"></span>
    <% end %>
    <h1 class="text-base font-semibold text-gray-900">โปรไฟล์ของฉัน</h1>
    <div class="relative">
      <input type="checkbox" id="profile-menu-toggle" class="peer hidden">
      <label for="profile-menu-toggle" class="inline-flex size-10 cursor-pointer items-center justify-center rounded-full text-gray-700 hover:bg-gray-100">
        <span class="sr-only">เปิดเมนู</span>
        <span class="iconify" data-icon="lucide:more-horizontal" data-width="22" aria-hidden="true"></span>
      </label>
      <button type="button"
              class="fixed inset-0 z-40 hidden cursor-default border-0 bg-transparent p-0 peer-checked:block"
              aria-label="ปิดเมนู"
              onclick="document.getElementById('profile-menu-toggle').checked = false"></button>
      <div class="absolute right-0 z-50 mt-2 w-52 origin-top-right scale-95 rounded-xl border border-gray-100 bg-white py-1 opacity-0 shadow-lg transition peer-checked:scale-100 peer-checked:opacity-100">
        <%= link_to edit_user_registration_path, class: "block px-4 py-2.5 text-sm text-gray-800 hover:bg-gray-50" do %>
          แก้ไขบัญชีของฉัน
        <% end %>
        <%= button_to destroy_user_session_path, method: :delete, class: "w-full text-left" do %>
          <span class="block px-4 py-2.5 text-sm text-red-600 hover:bg-red-50">ออกจากระบบ</span>
        <% end %>
      </div>
    </div>
  </header>

  <div class="px-4 pt-6">
    <div class="flex flex-col items-center text-center">
      <div class="size-24 shrink-0 overflow-hidden rounded-full border border-gray-200 bg-gray-100">
        <% if @user.avatar.attached? %>
          <%= image_tag @user.avatar, class: "size-full object-cover", alt: "" %>
        <% else %>
          <div class="size-full bg-[repeating-conic-gradient(#e5e7eb_0%_25%,#f3f4f6_0%_50%)] bg-[length:12px_12px]"></div>
        <% end %>
      </div>
      <p class="mt-4 text-lg font-bold text-gray-900">
        <%= [@user.first_name, @user.last_name].compact_blank.join(" ") %>
      </p>
      <p class="mt-1 text-sm text-gray-500"><%= @user.email %></p>
    </div>

    <section class="mt-8">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">คำสั่งซื้อของฉัน</h2>
        <%= link_to users_orders_path(status: :paid), class: "text-sm font-medium text-Primary-color" do %>
          ดูประวัติการซื้อ
          <span aria-hidden="true">›</span>
        <% end %>
      </div>
      <div class="grid grid-cols-3 gap-2">
        <%= link_to cart_path, class: "flex flex-col items-center rounded-2xl border border-gray-100 bg-white py-4 shadow-sm transition hover:border-pink-200" do %>
          <span class="mb-2 flex size-12 items-center justify-center rounded-full bg-pink-50 text-pink-600">
            <span class="iconify" data-icon="lucide:shopping-cart" data-width="22"></span>
          </span>
          <span class="text-center text-[11px] font-medium leading-tight text-gray-700">รถเข็นของฉัน</span>
        <% end %>
        <%= link_to users_orders_path(status: :pending), class: "flex flex-col items-center rounded-2xl border border-gray-100 bg-white py-4 shadow-sm transition hover:border-pink-200" do %>
          <span class="mb-2 flex size-12 items-center justify-center rounded-full bg-pink-50 text-pink-600">
            <span class="iconify" data-icon="lucide:wallet" data-width="22"></span>
          </span>
          <span class="text-center text-[11px] font-medium leading-tight text-gray-700">รอชำระเงิน</span>
        <% end %>
        <%= link_to users_orders_path(status: :paid), class: "flex flex-col items-center rounded-2xl border border-gray-100 bg-white py-4 shadow-sm transition hover:border-pink-200" do %>
          <span class="mb-2 flex size-12 items-center justify-center rounded-full bg-pink-50 text-pink-600">
            <span class="iconify" data-icon="lucide:package" data-width="22"></span>
          </span>
          <span class="text-center text-[11px] font-medium leading-tight text-gray-700">รอรับสินค้า</span>
        <% end %>
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-base font-semibold text-gray-900">บัญชีของฉัน</h2>
      <p class="mt-1 text-xs text-gray-400">สามารถแก้ไขได้ที่สามจุดด้านบนขวา</p>
      <div class="mt-3 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm">
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-xs text-gray-400">ชื่อ</dt>
            <dd class="mt-0.5 font-medium text-gray-900"><%= [@user.first_name, @user.last_name].compact_blank.join(" ") %></dd>
          </div>
          <div>
            <dt class="text-xs text-gray-400">เบอร์โทร</dt>
            <dd class="mt-0.5 text-gray-900"><%= masked_thai_mobile(@user.phone_number) %></dd>
          </div>
          <div>
            <dt class="text-xs text-gray-400">ที่อยู่</dt>
            <dd class="mt-0.5 leading-relaxed text-gray-800"><%= @user.location.presence || "—" %></dd>
          </div>
        </dl>
      </div>
    </section>
  </div>
</div>
