<div class="min-h-screen max-w-md mx-auto pb-24 bg-gradient-to-b from-rose-50/70 via-white to-slate-50/90">
  <header class="sticky top-0 z-30 flex items-center justify-center border-b border-rose-100/80 bg-white/85 px-4 py-3 shadow-sm backdrop-blur-md">
    <h1 class="text-base font-semibold tracking-tight text-slate-900">แก้ไขที่อยู่</h1>
  </header>

  <div class="px-4 pt-6">
    <%= form_with model: @shipping_address,
          url: users_shipping_address_path(@shipping_address),
          method: :patch,
          local: true,
          html: { data: { turbo: false }, class: "space-y-6" } do |f| %>
      <% if @checkout_order_id.present? %>
        <%= hidden_field_tag :order_id, @checkout_order_id %>
        <%= hidden_field_tag :return_to, @checkout_return_to %>
      <% end %>

      <% if @shipping_address.errors.any? %>
        <div class="rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800">
          <ul class="list-inside list-disc space-y-1">
            <% @shipping_address.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= render "users/shipping_addresses/fields", af: f %>

      <%= f.submit "บันทึกการเปลี่ยนแปลง",
            class: "w-full py-3.5 text-white text-base font-medium rounded-full bg-gradient-to-r from-pink-500 to-pink-600 shadow-lg shadow-pink-200 hover:opacity-90 active:scale-[0.98] transition duration-200" %>
    <% end %>
  </div>
</div>
