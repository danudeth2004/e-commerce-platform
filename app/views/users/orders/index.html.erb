<% content_for :title, "ประวัติการซื้อ" %>
<div class="min-h-screen bg-white max-w-md mx-auto pb-12">
    <header class="sticky top-0 z-30 flex items-center gap-3 border-b border-gray-100 bg-white px-4 py-3">
        <%= link_to users_profile_path, class: "inline-flex size-10 items-center justify-center rounded-full text-gray-700 hover:bg-gray-100", aria: { label: "กลับ" } do %>
        <span class="iconify text-2xl" data-icon="lucide:chevron-left" data-width="24"></span>
        <% end %>
        <h1 class="text-base font-semibold text-gray-900">ประวัติการซื้อ</h1>
    </header>

    <div class="px-4 py-4">
        <% if @orders.any? %>
        <ul class="space-y-3">
            <% @orders.each do |order| %>
            <%= link_to(order.paid? ? users_order_path(order) : payment_checkout_path(order_id: order.id, status: "pending"),
                class: "block rounded-2xl border border-gray-100 bg-white p-4 shadow-sm") do %>

            <div class="flex items-start justify-between gap-2">
                <div>
                    <p class="text-xs text-gray-400">คำสั่งซื้อ #<%= order.id %></p>
                    <p class="mt-1 text-sm font-semibold text-gray-900">
                        ฿ <%= number_with_delimiter(order.total_amount.to_f.round) %>
                    </p>
                    <p class="mt-1 text-xs text-gray-500">
                        <% if order.paid? %>
                        <%= "วันที่ชำระเงิน #{order.paid_at.strftime("%d/%m/%Y %H:%M")}" %>
                        <% else %>
                        <%= "วันที่สร้างคำสั่งซื้อ #{order.created_at.strftime("%d/%m/%Y %H:%M")}" %>
                        <% end %>
                    </p>

                    <% if order.paid? && order.paid_at.present? %>
                    <p class="mt-1 text-xs <%= order.shipping_cents > 0 ? "text-emerald-600" : "text-gray-500" %>">
                        <% if order.shipping_cents > 0 %>
                        🚚 ส่งพรุ่งนี้ (<%= (order.paid_at + 1.day).strftime("%d/%m") %>)
                        <% else %>
                        🚚 ส่งใน 2-3 วัน
                        (<%= (order.paid_at + 2.days).strftime("%d/%m") %> -
                        <%= (order.paid_at + 3.days).strftime("%d/%m") %>)
                        <% end %>
                    </p>
                    <% end %>
                </div>

                <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-medium
          <%= order.pending? ? "bg-amber-50 text-amber-800" : order.paid? ? "bg-emerald-50 text-emerald-800" : "bg-gray-100 text-gray-700" %>">
                    <%= order.status == "pending" ? "รอชำระเงิน" : order.status == "paid" ? "ชำระแล้ว" : order.status %>
                </span>
            </div>

            <% end %>
            <% end %>
        </ul>
        <% else %>
        <p class="py-12 text-center text-sm text-gray-500">ยังไม่มีคำสั่งซื้อในหมวดนี้</p>
        <% end %>
    </div>
</div>