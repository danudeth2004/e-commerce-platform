
<div class="min-h-screen max-w-md mx-auto pb-12 bg-gradient-to-b from-rose-50/70 via-white to-slate-50/90">
  <header class="sticky top-0 z-30 flex items-center gap-3 border-b border-rose-100/80 bg-white/85 backdrop-blur-md px-4 py-3 shadow-sm shadow-rose-100/30">
    <%= link_to users_profile_path, class: "inline-flex size-10 items-center justify-center rounded-full text-slate-600 hover:bg-rose-50/90 transition", aria: { label: "กลับ" } do %>
      <span class="iconify text-2xl" data-icon="lucide:chevron-left" data-width="24"></span>
    <% end %>
    <h1 class="text-base font-semibold tracking-tight text-slate-900">ประวัติการซื้อ</h1>
  </header>

  <div class="px-4 py-4">
    <% if @orders.any? %>
      <ul class="space-y-3">
        <% @orders.each do |order| %>
          <%= link_to(order.paid? ? users_order_path(order) : payment_checkout_path(order_id: order.id, status: "pending"),
              class: "block rounded-2xl border border-rose-100/80 bg-white/90 p-4 shadow-md shadow-rose-100/20 ring-1 ring-rose-50/40 transition hover:border-rose-200 hover:shadow-lg hover:shadow-rose-100/35 active:scale-[0.99]") do %>

            <div class="flex items-start justify-between gap-2">
              <div>
                <p class="text-xs font-medium text-slate-400">คำสั่งซื้อ #<%= order.id %></p>
                <p class="mt-1 text-base font-bold text-slate-900 tabular-nums">
                  <%= number_with_delimiter(order.total_amount) %> ฿
                </p>
                <p class="mt-1 text-xs text-slate-500">
                  <% if order.paid? %>
                    <%= "วันที่ชำระเงิน #{order.paid_at.strftime("%d/%m/%Y %H:%M")}" %>
                  <% else %>
                    <%= "วันที่สร้างคำสั่งซื้อ #{order.created_at.strftime("%d/%m/%Y %H:%M")}" %>
                  <% end %>
                </p>

                <% if order.paid? && order.paid_at.present? %>
                  <% delivered =
                      if order.shipping_cents > 0
                        Time.current >= order.paid_at + 1.day
                      else
                        Time.current >= order.paid_at + 3.days
                      end
                  %>

                  <p class="mt-1.5 text-xs <%= delivered ? "text-slate-500" : "text-emerald-600 font-medium" %>">
                    <% if delivered %>
                      📦 ส่งสินค้าแล้ว
                    <% else %>
                      <% if order.shipping_cents > 0 %>
                        🚚 ส่งพรุ่งนี้ (<%= (order.paid_at + 1.day).strftime("%d/%m") %>)
                      <% else %>
                        🚚 ส่งใน 2-3 วัน
                        (<%= (order.paid_at + 2.days).strftime("%d/%m") %> -
                        <%= (order.paid_at + 3.days).strftime("%d/%m") %>)
                      <% end %>
                    <% end %>
                  </p>
                <% end %>
              </div>

              <% if order.pending? %>
                <span class="shrink-0 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800 ring-1 ring-amber-100/80">
                  รอชำระเงิน
                </span>
              <% elsif order.paid? %>
                <span class="shrink-0 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-800 ring-1 ring-emerald-100/80">
                  ชำระแล้ว
                </span>
              <% else %>
                <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 ring-1 ring-slate-200/80">
                  <%= order.status %>
                </span>
              <% end %>
            </div>

          <% end %>
        <% end %>
      </ul>
    <% else %>
      <div class="rounded-2xl border border-dashed border-rose-200/80 bg-white/60 py-14 text-center">
        <p class="text-sm text-slate-500">ยังไม่มีคำสั่งซื้อในหมวดนี้</p>
      </div>
    <% end %>
  </div>
</div>
