<div class="w-full min-h-screen bg-white">
  <div class="w-full max-w-screen-xl mx-auto px-4 py-6 space-y-6">
    <% if @search_query.present? %>
      <div class="text-xl font-semibold text-text-primary">
        ผลการค้นหา “<%= @search_query %>”
      </div>
    <% elsif @skin_concern_key.present? %>
      <% concern = SkinConcern.all.find { |c| c[:key] == @skin_concern_key } %>
      <div class="text-xl font-semibold text-text-primary">
        สินค้าสำหรับ <%= concern&.dig(:label) || @skin_concern_key %>
      </div>
    <% end %>
    <%= turbo_frame_tag "products_frame" do %>
      <% if @bundle_products.any? %>
        <section class="mt-4 space-y-3">
          <div class="rounded-2xl border border-pink-100/80 bg-gradient-to-br from-pink-50/90 to-white px-4 py-3 -mx-0.5">
            <p class="text-xs font-semibold uppercase tracking-wide text-pink-600">เซตสินค้า</p>
            <div class="flex items-start justify-between gap-2 mt-0.5">
              <div>
                <p class="text-lg font-bold text-text-primary leading-tight">เซตที่คัดมาให้แล้ว</p>
                <p class="text-xs text-gray-500 mt-1">ครบชุด ราคาดีกว่าซื้อแยก</p>
              </div>
              <%= link_to "ดูทั้งหมด", products_path((@search_query.present? ? { q: @search_query } : {})), class: "text-sm font-medium text-Primary-color shrink-0 mt-0.5" %>
            </div>
          </div>
          <div class="flex gap-3 overflow-x-auto pb-2 snap-x snap-mandatory [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden -mx-1 px-1">
            <% @bundle_products.each do |product| %>
              <div class="shrink-0 w-[min(280px,85vw)] sm:w-72 snap-start">
                <%= render "shared/product_bundle_card",
                       product: product_to_card_hash(product),
                       full_width: true,
                       theme: :neutral %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
      <% if @standard_products.any? %>
        <section class="mt-4 space-y-3">
          <h2 class="text-lg font-semibold text-text-primary">
            <%= @bundle_products.any? ? "สินค้าชิ้นเดียว" : "สินค้าทั้งหมด" %>
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
            <% @standard_products.each do |product| %>
              <%= render "shared/product_card",
                     product: product_to_card_hash(product),
                     full_width: true %>
            <% end %>
          </div>
        </section>
      <% end %>
      <% if @bundle_products.empty? && @standard_products.empty? %>
        <p class="text-sm text-text-neutral-300 text-center py-12 rounded-2xl border border-dashed border-gray-200 bg-gray-50/50 mt-3">
          <% if @search_query.present? %>
            ไม่พบสินค้าที่ตรงกับ “<%= @search_query %>”
          <% else %>
            ไม่มีสินค้าในหมวดนี้
          <% end %>
        </p>
      <% end %>
    <% end %>
  </div>
</div>
