<div class="w-full min-h-screen bg-white">
    <div class="w-full max-w-screen-xl mx-auto px-4 py-6 space-y-6">
        <% if @skin_concern_key.present? %>
        <% concern = SkinConcern.all.find { |c| c[:key] == @skin_concern_key } %>
        <h1 class="text-xl font-semibold text-text-primary">
            สินค้าสำหรับ <%= concern&.dig(:label) || @skin_concern_key %>
        </h1>
        <% else %>
        <h1 class="text-xl font-semibold text-text-primary">
            สินค้าทั้งหมด
        </h1>
        <% end %>

        <%= turbo_frame_tag "products_frame" do %>
        <%= render "shared/product_category_filter",
             current_category_key: @category_key,
             path_proc: lambda { |key|
               opts = {}
               opts[:skin_concern] = @skin_concern_key if @skin_concern_key.present?
               opts[:category] = key if key.present?
               products_path(opts)
             } %>

        <% if @bundle_products.any? %>
          <section class="mt-4 space-y-3">
            <h2 class="text-lg font-semibold text-text-primary">เซตสินค้า</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
              <% @bundle_products.each do |product| %>
                <%= render "shared/product_bundle_card",
                     product: product_to_card_hash(product),
                     full_width: true %>
              <% end %>
            </div>
          </section>
        <% end %>

        <% if @standard_products.any? %>
          <section class="mt-4 space-y-3">
            <h2 class="text-lg font-semibold text-text-primary">
              <%= @bundle_products.any? ? "สินค้าชิ้นเดียว" : "สินค้าทั้งหมด" %>
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
              <% @standard_products.each do |product| %>
                <%= render "shared/product_card",
                     product: product_to_card_hash(product),
                     full_width: true %>
              <% end %>
            </div>
          </section>
        <% end %>

        <% if @bundle_products.empty? && @standard_products.empty? %>
          <p class="text-sm text-text-neutral-300 text-center py-12 rounded-2xl border border-dashed border-gray-200 bg-gray-50/50 mt-3">
            ไม่มีสินค้าในหมวดนี้
          </p>
        <% end %>
        <% end %>
    </div>
</div>
