<%
=begin%>
 <div
  data-controller="omise-payment"
  data-omise-payment-public-key-value="<%= @public_key %>"
  data-public-key="<%= @public_key %>"
  data-amount="<%= @order.total_amount_cents %>"
>

  <p>Order ID: <%= @order.id %></p>

  <p>
    Total:
    <%= humanized_money_with_symbol(@order.total_amount) %>
  </p>

  <button
    data-action="click->omise-payment#pay"
    data-omise-payment-target="button"
    class="py-2 px-4 border border-3 border-black bg-green-300 text-2xl font-bold">
    Pay with Omise
  </button>

  <div class="flex flex-col gap-6 mt-10">
    <h1 class="text-2xl font-bold">
      Order Payouts
    </h1>

    <% @payouts.each do |payout| %>
      <div class="border border-black p-4 flex justify-between items-center">
        
        <div>
          <div>
            Store: <%= payout.store.name %>
          </div>

          <div>
            Amount:
            <%= number_to_currency(payout.amount_cents / 100.0) %>
          </div>

          <div>
            Status:
            <span class="font-bold">
              <%= payout.status %>
            </span>
          </div>
        </div>

        <%= link_to "View Payout",
            admin_order_store_payout_path(payout),
            class: "px-4 py-2 bg-blue-400 border border-black font-bold" %>

      </div>
    <% end %>
  </div>

  <form
    action="<%= pay_checkout_path %>"
    method="POST"
    data-omise-payment-target="form">

    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <input type="hidden" name="order_id" value="<%= @order.id %>">
    <input type="hidden" name="omise_token"
           data-omise-payment-target="token">
  </form>

</div> 
<%
=end%>
