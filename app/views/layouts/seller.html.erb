<!DOCTYPE html>
<html lang="th">
  <head>
    <title><%= content_for(:title) || "Seller: E Commerce Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="E Commerce Platform">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= render "layouts/google_fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  </head>

  <body class="font-sans antialiased">
    <main class="min-h-screen bg-white">
      <header class="mx-auto w-full max-w-screen-xl px-4 py-4">
        <%= form_with url: products_path, method: :get, local: true, class: "w-full min-w-0", role: "search" do %>
          <div class="relative flex items-center">
            <label for="header-search-q" class="sr-only">ค้นหาสินค้า</label>
            <span class="pointer-events-none absolute left-3.5 flex text-gray-400" aria-hidden="true">
              <%= inline_svg_tag "icons/search-icon.svg", class: "w-[18px] h-[18px]" %>
            </span>
            <%= text_field_tag :q, params[:q],
                  id: "header-search-q",
                  placeholder: "ค้นหาสินค้า...",
                  autocomplete: "off",
                  class: "w-full rounded-full border border-gray-200 bg-white py-2.5 pl-10 pr-4 text-sm text-gray-800 placeholder:text-gray-400 shadow-sm focus:border-pink-300 focus:outline-none focus:ring-2 focus:ring-pink-200/60" %>
          </div>
        <% end %>
      </header>

      <div class="w-full max-w-screen-xl mx-auto px-4">
        <%= render "layouts/flash_messages" %>
      </div>

      <%= yield %>
    </main>
  </body>
</html>
