<aside class="w-64 bg-slate-900 text-slate-300 flex flex-col shrink-0">
    <div class="p-6 text-white font-bold text-xl">
        Admin Management
    </div>
    <nav class="flex-1 px-4 space-y-2 pb-6">

        <%= link_to admin_root_path,
      class: admin_nav_item_classes(controller.controller_name == "home") do %>
        <span class="iconify" data-icon="lucide:layout-dashboard"></span>
        <span>ภาพรวม</span>
        <% end %>

        <%= link_to edit_admin_user_registration_path,
      class: admin_nav_item_classes(controller.controller_path == "admin/users/registrations" && %w[edit update].include?(action_name)) do %>
        <span class="iconify" data-icon="lucide:user-cog"></span>
        <span>บัญชีผู้ดูแล</span>
        <% end %>

        <%= link_to admin_buyers_path,
      class: admin_nav_item_classes(controller.controller_name == "buyers") do %>
        <span class="iconify" data-icon="lucide:users"></span>
        <span>ลูกค้า</span>
        <% end %>

        <%= link_to admin_stores_path,
      class: admin_nav_item_classes(controller.controller_name == "stores") do %>
        <span class="iconify" data-icon="lucide:store"></span>
        <span>ร้านค้า</span>
        <% end %>

        <%= link_to admin_order_store_payouts_path,
      class: admin_nav_item_classes(controller.controller_name == "order_store_payouts") do %>
        <span class="iconify" data-icon="lucide:banknote"></span>
        <span>การโอนเงิน</span>
        <% end %>

        <%= link_to admin_campaigns_path,
      class: admin_nav_item_classes(controller.controller_name == "campaigns") do %>
        <span class="iconify" data-icon="lucide:percent"></span>
        <span>แคมเปญ</span>
        <% end %>
    </nav>
</aside>
