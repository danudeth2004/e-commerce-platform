<!DOCTYPE html>
<html lang="th">
  <head>
    <title><%= content_for(:title) || "Buyer: E Commerce Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="E Commerce Platform">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= render "layouts/google_fonts" %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.omise.co/omise.js"></script>
    <script src="https://cdn.omise.co/omise-card.js"></script>
    <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  </head>
  <body class="font-sans antialiased">
    <main class="min-h-screen bg-white<%= ' pb-[calc(4.25rem+env(safe-area-inset-bottom,0px))]' if show_buyer_bottom_nav? %>">
      <% if flash.any? %>
        <%= render "layouts/flash_messages" %>
      <% end %>
      <% if show_app_header? %>
        <%# Linear gradient (Figma): 0% #FF1493 → 50% #FF69B4 → 100% #F6DBD8 %>
        <% header_icon_btn = "inline-flex items-center justify-center size-11 shrink-0 rounded-2xl bg-gradient-to-r from-[#FF1493] via-[#FF69B4] to-[#F6DBD8] text-white shadow-sm transition hover:opacity-95 active:scale-[0.98] [&_svg]:drop-shadow-[0_1px_1px_rgba(0,0,0,0.18)]" %>
        <header class="w-full max-w-screen-xl mx-auto px-4 pt-10 bg-white">
          <div class="flex items-center gap-2.5 sm:gap-3">
            <%= form_with url: products_path, method: :get, local: true, html: { class: "flex-1 min-w-0", id: "header-product-search", role: "search" } do %>
              <%= hidden_field_tag :skin_concern, params[:skin_concern] if params[:skin_concern].present? %>
              <%= hidden_field_tag :category, params[:category] if params[:category].present? %>
              <div class="relative flex items-center">
                <label for="header-search-q" class="sr-only">ค้นหาสินค้า</label>
                <span class="pointer-events-none absolute left-3.5 flex text-gray-400" aria-hidden="true">
                  <%= inline_svg_tag "icons/search-icon.svg", class: "w-[18px] h-[18px]" %>
                </span>
                <%= search_field_tag :q, params[:q],
                                           id: "header-search-q",
                                           placeholder: "ค้นหาชื่อสินค้า แบรนด์ หรือคำอธิบาย",
                                           autocomplete: "off",
                                           enterkeyhint: "search",
                                           class: "w-full rounded-full border border-gray-200 bg-white py-2.5 pl-10 pr-4 text-sm text-gray-800 placeholder:text-gray-400 shadow-sm focus:border-pink-300 focus:outline-none focus:ring-2 focus:ring-pink-200/60" %>
              </div>
            <% end %>
            <div class="flex items-center gap-2 shrink-0">
              <%= link_to(user_signed_in? ? cart_path : new_user_session_path,
                                class: "#{header_icon_btn} relative") do %>
                <%= inline_svg_tag "icons/shopping-cart-icon.svg", class: "w-[22px] h-[22px] text-white" %>
                <% if user_signed_in? %>
                  <% count = current_cart_item_count %>
                  <% if count.positive? %>
                    <span class="absolute -top-1 -right-1 min-w-[1.125rem] rounded-full bg-red-500 px-1 py-0.5 text-center text-[10px] font-semibold leading-none text-white">
                      <%= count %>
                    </span>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        </header>
      <% end %>
      <%= yield %>
      <% if show_buyer_bottom_nav? %>
        <%= render "layouts/buyer_bottom_nav" %>
      <% end %>
    </main>
  </body>
</html>
