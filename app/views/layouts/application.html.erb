<!DOCTYPE html>
<html lang="th">

<head>
    <title><%= content_for(:title) || "Buyer: E Commerce Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="E Commerce Platform">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script src="https://cdn.omise.co/omise.js"></script>
    <script src="https://cdn.omise.co/omise-card.js"></script>
    <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
</head>

<body class="font-sans">
    <main class="min-h-screen bg-white">
        <header class="w-full max-w-screen-xl mx-auto px-4 pt-4 flex items-center justify-between">
            <div class="text-lg font-semibold text-text-primary">
                <%= link_to "E Commerce Platform", root_path %>
            </div>

            <% if user_signed_in? %>
            <%= link_to cart_path, class: "relative inline-flex items-center justify-center" do %>
            <%= inline_svg_tag "icons/shopping-cart-icon.svg", class: "w-6 h-6 text-gray-700" %>
            <% count = current_cart_item_count %>
            <% if count.positive? %>
            <span class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-semibold rounded-full px-1.5 py-0.5">
                <%= count %>
            </span>
            <% end %>
            <% end %>
            <% end %>
        </header>

        <%= yield %>
    </main>
</body>

</html>
