<!DOCTYPE html>
<html lang="th">

<head>
    <title><%= content_for(:title) || "RUNA" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="E Commerce Platform">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "layouts/favicon" %>

    <%= render "layouts/google_fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
</head>

<body class="bg-white text-gray-800 font-sans antialiased">
    <% if flash.any? %>
        <%= render "layouts/flash_messages" %>
    <% end %>
    <main class="min-h-screen flex items-top justify-center pt-10">
        <div class="w-[80dvh] px-6 py-10 bg-white">
            <%= yield %>
        </div>
    </main>
</body>

</html>
